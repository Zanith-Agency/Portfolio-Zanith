---
import Header from "../components/Header.astro";
import "../styles/variables.css";

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
  headerVariant?: "light" | "dark";
  pageLabel?: string;
}
const { title, description = "Zanith — développement web et media buying, Bruxelles.", isHome = false, headerVariant = "light", pageLabel } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header startInIntro={isHome} variant={headerVariant} pageLabel={pageLabel} />
    <main><slot /></main>
    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll";
      initSmoothScroll();
    </script>
  </body>
</html>