---
// Introduction sur mesure du projet El Mágico Barber.
//
// Principe : les deux univers partagent les MÊMES emplacements
// (.elm-slot--title, --screen, --a, --b, --meta). Chaque élément du
// site final occupe exactement la place de son équivalent de
// conception, de sorte qu'en remontant la frontière :
//   - l'écran d'accueil du site devient sa maquette Figma,
//   - le titre devient sa sélection typographique,
//   - l'accroche devient le spécimen des polices,
//   - la photo d'un artiste devient la palette,
//   - l'autre photo devient l'image brute, avec ses repères de cadrage.
//
// Images : public/projets/el-magico/ (captures du site final et export
// de la maquette Figma fournis par Nadir).
import ProjectReveal from "../ProjectReveal.astro";
import type { Project } from "../../lib/supabase";

// Polices de la marque, hébergées avec le site (aucune requête vers
// Google Fonts). Paquets : @fontsource/cormorant-garamond, @fontsource/work-sans
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/600.css";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const assets = "/projets/el-magico";

// Nom de domaine affiché sous l'accroche (ex : elmagicobarber.be)
let siteHost: string | null = null;
try {
  siteHost = project.site_url ? new URL(project.site_url).hostname.replace(/^www\./, "") : null;
} catch {
  siteHost = null;
}
const meta = [project.project_year, siteHost].filter(Boolean).join(" — ");

// Palette relevée sur le site en ligne
const palette = [
  { name: "Anthracite", hex: "#232323" },
  { name: "Doré", hex: "#C19A6B" },
  { name: "Crème", hex: "#F3ECE0" },
  { name: "Blanc", hex: "#FFFFFF" },
];
---

<ProjectReveal headerTheme="dark">
  <!-- ============ Univers 1 — PROJECT SHOWCASE : le site final ============ -->
  <div slot="showcase" class="elm elm--showcase">
    <div class="elm-glow" aria-hidden="true"></div>

    <div class="elm-slot elm-slot--title">
      <span class="elm-kicker">{project.category}</span>
      <h1 class="elm-title">
        <span class="elm-title-line">El Mágico</span>
        <span class="elm-title-line elm-title-line--italic">Barber.</span>
      </h1>
    </div>

    <div class="elm-slot elm-slot--meta">
      {project.tagline && <p class="elm-tagline">{project.tagline}</p>}
      {meta && <p class="elm-meta">{meta}</p>}
    </div>

    <figure class="elm-slot elm-slot--screen elm-laptop">
      <img
        src={`${assets}/site-accueil.webp`}
        alt="Page d'accueil du site El Mágico Barber"
        width="1800"
        height="927"
        fetchpriority="high"
      />
    </figure>

    <figure class="elm-slot elm-slot--a elm-photo">
      <img src={`${assets}/artiste-3.webp`} alt="" width="615" height="771" />
      <figcaption>01</figcaption>
    </figure>

    <figure class="elm-slot elm-slot--b elm-photo">
      <img src={`${assets}/artiste-1.webp`} alt="" width="615" height="771" />
      <figcaption>02</figcaption>
    </figure>
  </div>

  <!-- ============ Univers 2 — BEHIND THE SCENES : la conception ============ -->
  <div slot="behind" class="elm elm--behind">
    <div class="elm-canvas" aria-hidden="true"></div>

    <!-- Le titre, sélectionné comme dans Figma -->
    <div class="elm-slot elm-slot--title" aria-hidden="true">
      <span class="elm-kicker elm-kicker--tool">Cormorant Garamond</span>
      <div class="elm-title elm-selected">
        <span class="elm-title-line">El Mágico</span>
        <span class="elm-title-line elm-title-line--italic">Barber.</span>
        <span class="elm-handle elm-handle--tl" aria-hidden="true"></span>
        <span class="elm-handle elm-handle--tr" aria-hidden="true"></span>
        <span class="elm-handle elm-handle--bl" aria-hidden="true"></span>
        <span class="elm-handle elm-handle--br" aria-hidden="true"></span>
      </div>
    </div>

    <!-- L'accroche devient le spécimen typographique -->
    <div class="elm-slot elm-slot--meta elm-typespec">
      <div class="elm-typespec-row">
        <span class="elm-aa elm-aa--serif" aria-hidden="true">Aa</span>
        <span class="elm-typespec-text">
          <strong>Cormorant Garamond</strong>
          <span>Titres · 400 → 700 · Italique</span>
        </span>
      </div>
      <div class="elm-typespec-row">
        <span class="elm-aa elm-aa--sans" aria-hidden="true">Aa</span>
        <span class="elm-typespec-text">
          <strong>Work Sans</strong>
          <span>Texte courant · 400 · 600</span>
        </span>
      </div>
    </div>

    <!-- L'écran du site devient sa maquette -->
    <figure class="elm-slot elm-slot--screen elm-frame">
      <figcaption class="elm-frame-label">Accueil — maquette Figma</figcaption>
      <img
        src={`${assets}/maquette-accueil.webp`}
        alt="Maquette Figma de la page d'accueil d'El Mágico Barber"
        width="1600"
        height="823"
        loading="eager"
        decoding="async"
      />
      <span class="elm-handle elm-handle--tl" aria-hidden="true"></span>
      <span class="elm-handle elm-handle--tr" aria-hidden="true"></span>
      <span class="elm-handle elm-handle--bl" aria-hidden="true"></span>
      <span class="elm-handle elm-handle--br" aria-hidden="true"></span>
    </figure>

    <!-- La photo 01 devient la palette -->
    <div class="elm-slot elm-slot--a elm-palette">
      <span class="elm-palette-title">Palette</span>
      <ul>
        {palette.map((color) => (
          <li>
            <span class="elm-swatch" style={`background: ${color.hex}`}></span>
            <span class="elm-swatch-name">{color.name}</span>
            <span class="elm-swatch-hex">{color.hex}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- La photo 02 redevient une image brute, en cours de cadrage -->
    <figure class="elm-slot elm-slot--b elm-raw">
      <img src={`${assets}/artiste-1.webp`} alt="" width="615" height="771" loading="eager" decoding="async" />
      <span class="elm-crop elm-crop--tl" aria-hidden="true"></span>
      <span class="elm-crop elm-crop--br" aria-hidden="true"></span>
      <figcaption>Mur des artistes</figcaption>
    </figure>

    <!-- En plus dans les coulisses : la grille tarifaire à onglets -->
    <figure class="elm-slot elm-slot--extra elm-frame elm-frame--small">
      <figcaption class="elm-frame-label">Tarifs — onglets par salon et par barbier</figcaption>
      <img
        src={`${assets}/tarifs.webp`}
        alt="Grille tarifaire avec onglets par salon et par barbier"
        width="1100"
        height="775"
        loading="eager"
        decoding="async"
      />
    </figure>

    <!-- Commentaire façon Figma -->
    <div class="elm-slot elm-slot--comment elm-comment">
      <span class="elm-comment-avatar" aria-hidden="true">N</span>
      <span class="elm-comment-text">Inspirations : sites Awwwards</span>
    </div>
  </div>
</ProjectReveal>

<style>
  /* ============ Base commune aux deux univers ============ */

  .elm {
    --elm-anthracite: #232323;
    --elm-gold: #c19a6b;
    --elm-cream: #f3ece0;
    --elm-figma: #0d99ff;

    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--elm-cream);
    font-family: "Work Sans", system-ui, sans-serif;
  }

  .elm figure {
    margin: 0;
  }

  .elm img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Les emplacements partagés (même géométrie dans les deux scènes) ---
     Largeurs en % de la section, plafonnées en vh pour les écrans larges
     mais peu hauts ; hauteurs déduites des proportions des images. */
  .elm-slot {
    position: absolute;
    /* Bordures et marges intérieures comprises dans la taille : sinon
       une carte avec cadre serait plus grande que son équivalent dans
       l'autre univers. */
    box-sizing: border-box;
  }

  .elm-slot--title {
    left: 6%;
    top: 26%;
    width: 38%;
  }

  .elm-slot--meta {
    left: 6%;
    top: 63%;
    width: 30%;
  }

  .elm-slot--screen {
    left: 47%;
    top: 22%;
    width: min(44%, 82vh);
    aspect-ratio: 1800 / 927;
  }

  .elm-slot--a {
    left: 41%;
    top: 51%;
    width: min(12.5%, 24vh);
    aspect-ratio: 4 / 5;
  }

  .elm-slot--b {
    left: 86%;
    top: 14%;
    width: min(10.5%, 20vh);
    aspect-ratio: 4 / 5;
  }

  /* Uniquement dans les coulisses */
  .elm-slot--extra {
    left: 61%;
    top: 67%;
    width: min(22%, 34vh);
    aspect-ratio: 1100 / 775;
  }

  .elm-slot--comment {
    left: 27%;
    top: 13%;
  }

  /* --- Titre --- */
  .elm-kicker {
    display: block;
    margin-bottom: 1.1rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--elm-gold);
  }

  .elm-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 400;
    font-size: min(7vw, 13vh);
    line-height: 1;
    color: #ffffff;
  }

  .elm-title-line--italic {
    font-style: italic;
    color: var(--elm-gold);
  }

  /* ============ Univers 1 — vitrine ============ */

  .elm--showcase {
    background: #1b1b1b;
  }

  .elm-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 60% at 70% 42%, rgba(193, 154, 107, 0.18), transparent 70%),
      radial-gradient(ellipse 60% 50% at 0% 100%, rgba(193, 154, 107, 0.08), transparent 70%);
  }

  .elm-tagline {
    margin: 0 0 1.25rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--elm-cream) 70%, transparent);
  }

  .elm-meta {
    margin: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: color-mix(in srgb, var(--elm-cream) 55%, transparent);
  }

  /* Ordinateur : la capture est l'écran, le cadre et le socle sont
     dessinés autour SANS changer la taille de l'emplacement, pour que
     l'écran tombe exactement sur la maquette des coulisses. */
  .elm-laptop {
    border-radius: 6px;
    box-shadow:
      0 0 0 10px #0c0c0c,
      0 0 0 11px #3a3a3a,
      0 40px 80px rgba(0, 0, 0, 0.6);
  }
  .elm-laptop img {
    border-radius: 6px;
  }
  .elm-laptop::after {
    content: "";
    position: absolute;
    left: -9%;
    right: -9%;
    top: calc(100% + 11px);
    height: 14px;
    border-radius: 0 0 14px 14px;
    background: linear-gradient(to bottom, #4a4a4a, #222);
    box-shadow: 0 20px 30px rgba(0, 0, 0, 0.5);
  }

  /* Photos : cartes en verre, comme sur le site */
  .elm-photo {
    padding: 6px;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--elm-cream) 22%, transparent);
    background: rgba(217, 217, 217, 0.08);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
  }
  .elm-photo img {
    border-radius: 12px;
  }
  .elm-photo figcaption {
    position: absolute;
    right: 14px;
    bottom: 12px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 0.9rem;
    color: #ffffff;
  }

  /* ============ Univers 2 — coulisses ============ */

  .elm--behind {
    background: #141414;
  }

  /* Canevas de travail : grille de points */
  .elm-canvas {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(243, 236, 224, 0.1) 1px, transparent 1.2px);
    background-size: 22px 22px;
  }

  .elm-kicker--tool {
    font-family: "Work Sans", system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--elm-figma);
  }

  /* Calque de texte sélectionné : un seul cadre autour du bloc, avec
     ses poignées, comme dans Figma */
  .elm-selected {
    position: relative;
    width: fit-content;
    outline: 1px solid var(--elm-figma);
    outline-offset: 8px;
  }
  .elm-selected .elm-handle--tl { left: -13px; top: -13px; }
  .elm-selected .elm-handle--tr { right: -13px; top: -13px; }
  .elm-selected .elm-handle--bl { left: -13px; bottom: -13px; }
  .elm-selected .elm-handle--br { right: -13px; bottom: -13px; }

  /* Spécimen typographique */
  .elm-typespec {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .elm-typespec-row {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .elm-aa {
    flex-shrink: 0;
    width: 3.6rem;
    font-size: 2.6rem;
    line-height: 1;
    color: #ffffff;
  }
  .elm-aa--serif {
    font-family: "Cormorant Garamond", Georgia, serif;
  }
  .elm-aa--sans {
    font-family: "Work Sans", system-ui, sans-serif;
    font-size: 2.1rem;
  }
  .elm-typespec-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--elm-cream) 60%, transparent);
  }
  .elm-typespec-text strong {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--elm-cream);
  }

  /* Cadre Figma : contour de sélection, poignées, nom du cadre */
  .elm-frame {
    outline: 1.5px solid var(--elm-figma);
  }
  .elm-frame-label {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.55rem);
    font-size: 0.72rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--elm-cream) 65%, transparent);
  }
  .elm-handle {
    position: absolute;
    width: 9px;
    height: 9px;
    background: #ffffff;
    border: 1.5px solid var(--elm-figma);
  }
  .elm-handle--tl { left: -5px; top: -5px; }
  .elm-handle--tr { right: -5px; top: -5px; }
  .elm-handle--bl { left: -5px; bottom: -5px; }
  .elm-handle--br { right: -5px; bottom: -5px; }

  .elm-frame--small {
    outline-color: color-mix(in srgb, var(--elm-cream) 25%, transparent);
  }
  .elm-frame--small img {
    border-radius: 2px;
  }

  /* Palette */
  .elm-palette {
    display: flex;
    flex-direction: column;
    padding: 0.9rem;
    border-radius: 10px;
    background: #1e1e1e;
    border: 1px solid color-mix(in srgb, var(--elm-cream) 12%, transparent);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
  }
  .elm-palette-title {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--elm-cream) 55%, transparent);
    margin-bottom: 0.7rem;
  }
  .elm-palette ul {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .elm-palette li {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.6rem;
    align-items: center;
  }
  .elm-swatch {
    grid-row: 1 / 3;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--elm-cream) 20%, transparent);
  }
  .elm-swatch-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--elm-cream);
  }
  .elm-swatch-hex {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: color-mix(in srgb, var(--elm-cream) 55%, transparent);
  }

  /* Image brute en cours de cadrage */
  .elm-raw img {
    filter: grayscale(1) contrast(1.05);
    opacity: 0.85;
  }
  .elm-raw figcaption {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    font-size: 0.65rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--elm-cream) 55%, transparent);
  }
  .elm-crop {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: var(--elm-gold);
    border-style: solid;
    border-width: 0;
  }
  .elm-crop--tl { left: -8px; top: -8px; border-top-width: 1.5px; border-left-width: 1.5px; }
  .elm-crop--br { right: -8px; bottom: -8px; border-bottom-width: 1.5px; border-right-width: 1.5px; }

  /* Commentaire façon Figma */
  .elm-comment {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.9rem 0.45rem 0.45rem;
    border-radius: 999px 999px 999px 4px;
    background: #ffffff;
    color: #141414;
    font-size: 0.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }
  .elm-comment-avatar {
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--elm-gold);
    color: #141414;
    font-weight: 600;
    font-size: 0.75rem;
  }

  /* ============ Mobile et tablette portrait ============ */
  @media (max-width: 800px) {
    .elm-slot--title {
      left: 6%;
      top: 14%;
      width: 88%;
    }
    .elm-title {
      font-size: min(14vw, 9vh);
    }
    .elm-slot--meta {
      left: 6%;
      top: 34%;
      width: 88%;
    }
    .elm-slot--screen {
      left: 6%;
      top: 49%;
      width: 88%;
    }
    .elm-slot--a {
      left: 6%;
      top: 71%;
      width: min(30%, 17vh);
    }
    .elm-slot--b {
      left: auto;
      right: 6%;
      top: 71%;
      width: min(30%, 17vh);
    }
    .elm-slot--extra,
    .elm-slot--comment {
      display: none;
    }
    .elm-laptop {
      box-shadow:
        0 0 0 6px #0c0c0c,
        0 0 0 7px #3a3a3a,
        0 20px 40px rgba(0, 0, 0, 0.6);
    }
    .elm-laptop::after {
      top: calc(100% + 7px);
      height: 9px;
    }
    .elm-typespec {
      gap: 0.6rem;
    }
    .elm-aa {
      font-size: 2rem;
      width: 2.8rem;
    }
    .elm-aa--sans {
      font-size: 1.6rem;
    }
    .elm-palette {
      padding: 0.6rem;
    }
    .elm-palette-title {
      display: none;
    }
    .elm-swatch {
      width: 1.3rem;
      height: 1.3rem;
    }
    .elm-swatch-name {
      font-size: 0.62rem;
    }
    .elm-swatch-hex {
      font-size: 0.56rem;
    }
    .elm-raw figcaption {
      display: none;
    }
  }
</style>