---
// Contenus interactifs propres au projet El Mágico Barber, insérés dans
// l'étude de cas (voir customExtras dans src/pages/projets/[slug].astro) :
//   - section "process"     → l'atelier typo & couleurs
//   - section "development" → les captures annotées
// Pour toute autre section, le composant n'affiche rien.
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/600.css";

interface Props {
  section: string;
}

const { section } = Astro.props;

const palette = [
  { name: "Anthracite", hex: "#232323", use: "Fond", role: "anthracite" },
  { name: "Doré", hex: "#C19A6B", use: "Accents", role: "dore" },
  { name: "Crème", hex: "#F3ECE0", use: "Texte secondaire", role: "creme" },
  { name: "Blanc", hex: "#FFFFFF", use: "Titres", role: "blanc" },
];

const styles = [
  { id: "regular", label: "Regular" },
  { id: "italic", label: "Italique" },
  { id: "semibold", label: "SemiBold" },
];

// Captures annotées. Toutes les positions sont en % de l'image :
// - `zones` : les zones mises en valeur (x, y = coin haut-gauche ; w, h
//   = largeur, hauteur). Le zoom cadre l'ensemble des zones de la note.
// - `dot` : position du point numéroté.
const captures = [
  {
    id: "accueil",
    label: "Accueil",
    image: "/projects/elmagico/site-accueil.webp",
    width: 1800,
    height: 927,
    alt: "Page d'accueil du site El Mágico Barber",
    notes: [
      {
        dot: { x: 17.5, y: 7 },
        zones: [
          { x: 17.5, y: 7, w: 8, h: 7 },
          { x: 85, y: 5.5, w: 11.5, h: 9 },
        ],
        title: "Deux chemins vers la réservation",
        text: "Le lien « Réservation » du menu et le bouton « Services » mènent tous les deux à l'outil de réservation d'El Mágico. Où que le visiteur regarde, il est à un clic de prendre rendez-vous.",
      },
      {
        dot: { x: 85, y: 5.5 },
        zones: [{ x: 85, y: 5.5, w: 11.5, h: 9 }],
        title: "Le bouton Services se démarque",
        text: "Cerclé de doré, avec sa flèche dans une pastille pleine, c'est le seul élément du menu qui prend la forme d'un bouton. L'œil le repère avant les simples liens : c'est l'action principale de la page.",
      },
      {
        dot: { x: 66.5, y: 23 },
        zones: [{ x: 66.5, y: 23, w: 30, h: 65 }],
        title: "Une galerie qui montre le savoir-faire",
        text: "Dans une carte en verre, un diaporama de quatre photos montre le travail des barbiers et les caractéristiques du salon. Le visiteur juge la qualité technique et l'univers du lieu avant même de réserver.",
      },
    ],
  },
  {
    id: "solution",
    label: "La solution",
    image: "/projects/elmagico/solution.webp",
    width: 1800,
    height: 770,
    alt: "Section « La solution El Magico Barber » : les atouts du salon épinglés sur une photo",
    notes: [
      {
        dot: { x: 41, y: 15.5 },
        zones: [{ x: 41, y: 15.5, w: 57, h: 75 }],
        title: "Les atouts posés sur une vraie photo",
        text: "Plutôt qu'une liste d'icônes, les quatre atouts du salon (produits premium, style sur mesure, confort absolu, équipe passionnée) sont épinglés sur une photo réelle de l'intérieur, chacun relié par un fil à l'endroit qui l'illustre.",
      },
      {
        dot: { x: 9, y: 51 },
        zones: [
          { x: 9, y: 51, w: 16, h: 42 },
          { x: 55.5, y: 36, w: 9.5, h: 9.5 },
        ],
        title: "Une liste et une photo qui se répondent",
        text: "À gauche, une liste numérotée reprend les mêmes atouts. L'atout actif passe en doré, dans la liste comme sur la photo : le regard fait naturellement l'aller-retour entre le texte et l'image.",
      },
      {
        dot: { x: 2.5, y: 4 },
        zones: [{ x: 2, y: 3, w: 38, h: 34 }],
        title: "Une promesse en une phrase",
        text: "Le titre et un court paragraphe posent le ton : de l'accueil à la dernière touche de style, chaque coupe est présentée comme un moment de détente et de précision.",
      },
    ],
  },
  {
    id: "lookbook",
    label: "LookBook",
    image: "/projects/elmagico/lookbook.webp",
    width: 1800,
    height: 1200,
    alt: "Page LookBook du site El Mágico Barber : une grille de coupes tendance",
    notes: [
      {
        dot: { x: 69.5, y: 34 },
        zones: [{ x: 43.5, y: 6.5, w: 52.5, h: 93 }],
        title: "Les coupes du moment",
        text: "Le LookBook présente une sélection de coupes tendance et intemporelles en grandes photos verticales : le client voit d'un coup d'œil ce qui se fait en ce moment.",
      },
      {
        dot: { x: 43.5, y: 2.5 },
        zones: [
          { x: 43.5, y: 0.5, w: 10.5, h: 5 },
          { x: 71, y: 0.5, w: 11.5, h: 5 },
          { x: 43.5, y: 68.5, w: 10, h: 5 },
          { x: 71, y: 68.5, w: 14, h: 5 },
        ],
        title: "Un vocabulaire commun",
        text: "Chaque coupe porte son nom : Taper Fade, French Crop, Burst Fade, High Skin Fade… Le client peut montrer ou citer exactement ce qu'il veut à son barbier.",
      },
      {
        dot: { x: 5, y: 44 },
        zones: [
          { x: 5, y: 44, w: 31, h: 16 },
          { x: 43.5, y: 7, w: 24.5, h: 53 },
        ],
        title: "Survoler pour en savoir plus",
        text: "Au survol d'une coupe, le visiteur découvre sa description et le résultat réalisé dans le salon. Le LookBook devient une vitrine du travail de l'équipe, pas seulement un catalogue d'inspirations.",
      },
    ],
  },
  {
    id: "tarifs",
    label: "Tarifs",
    image: "/projects/elmagico/tarifs.webp",
    width: 1100,
    height: 775,
    alt: "Grille des tarifs du site El Mágico Barber",
    notes: [
      {
        dot: { x: 28.5, y: 2.5 },
        zones: [{ x: 28.5, y: 1.5, w: 42.5, h: 8.5 }],
        title: "D'abord, le salon",
        text: "Deux onglets séparent les salons d'Uccle et du centre-ville : chacun affiche sa propre grille. L'onglet actif passe en doré, on sait toujours où l'on se trouve.",
      },
      {
        dot: { x: 20.5, y: 18 },
        zones: [{ x: 20.5, y: 18, w: 60, h: 8 }],
        title: "Puis, le barbier",
        text: "Les tarifs varient d'un barbier à l'autre. Le visiteur choisit Jhonny, Farro ou Raymond et la grille se met à jour, sans changer de page.",
      },
      {
        dot: { x: 9, y: 33 },
        zones: [
          { x: 9, y: 33, w: 24, h: 20 },
          { x: 51.5, y: 33, w: 21.5, h: 20 },
          { x: 51.5, y: 60, w: 21.5, h: 20 },
        ],
        title: "Trois familles de prestations",
        text: "Coupes et barbes, soins et détente, techniques : les prestations sont rangées comme sur la carte d'un restaurant, avec des prix clairs et des fourchettes pour les techniques.",
      },
    ],
  },
];

// Masque sombre autour des zones d'une note (trou = zone)
const veilPath = (zones: { x: number; y: number; w: number; h: number }[]) =>
  "M0 0H100V100H0Z " + zones.map((z) => `M${z.x} ${z.y}h${z.w}v${z.h}h${-z.w}Z`).join(" ");
---

{section === "process" && (
  <div class="case-extra elm-lab" data-elm-lab data-case-reveal>
    <div class="extra-head extra-head--row">
      <div>
        <span class="extra-kicker">Atelier</span>
        <h3 class="extra-title">Essayez la charte El Mágico</h3>
      </div>
      <!-- Avec / sans la charte : montre ce que l'identité apporte -->
      <div class="lab-switch" role="group" aria-label="Affichage de l'aperçu">
        <button type="button" data-lab-theme="brand" aria-pressed="true">Avec la charte</button>
        <button type="button" data-lab-theme="plain" aria-pressed="false">Sans la charte</button>
      </div>
    </div>

    <div class="lab-grid">
      <div class="lab-controls">
        <label class="lab-field">
          <span>Votre titre</span>
          <input
            type="text"
            value="Une coupe nette. Un vrai barbier."
            maxlength="60"
            autocomplete="off"
            spellcheck="false"
            data-lab-input
          />
        </label>
        <p class="lab-hint">Un point sépare les deux lignes du titre, comme sur le site.</p>

        <div class="lab-field">
          <span>Seconde ligne</span>
          <div class="lab-styles" role="group" aria-label="Style de la seconde ligne">
            {styles.map((style, index) => (
              <button type="button" data-lab-style={style.id} aria-pressed={index === 1 ? "true" : "false"}>
                {style.label}
              </button>
            ))}
          </div>
        </div>

        <dl class="lab-fonts">
          <div>
            <dt>Titres</dt>
            <dd class="lab-font-serif">Cormorant Garamond</dd>
          </div>
          <div>
            <dt>Texte courant</dt>
            <dd class="lab-font-sans">Work Sans</dd>
          </div>
        </dl>
      </div>

      <!-- Aperçu : le haut de la page d'accueil, reconstruit en HTML -->
      <div class="lab-card is-brand" data-lab-card data-role="anthracite" aria-label="Aperçu de la page d'accueil">
        <div class="lab-card-nav">
          <span class="lab-card-logo" data-role="dore" aria-hidden="true">EM</span>
          <span class="lab-card-links" data-role="creme">Réservation&nbsp;&nbsp;LookBook&nbsp;&nbsp;À propos</span>
          <span class="lab-card-clock" data-role="creme">BXL&nbsp;<span data-lab-clock>--:--</span></span>
          <span class="lab-card-button" data-role="dore">
            <span>Services</span>
            <span class="lab-card-button-dot" aria-hidden="true">→</span>
          </span>
        </div>
        <div class="lab-card-body">
          <span class="lab-card-kicker" data-role="creme">Barber shop — Bruxelles</span>
          <p class="lab-card-title">
            <span class="lab-card-line" data-role="blanc" data-lab-line1>Une coupe nette.</span>
            <span class="lab-card-line lab-card-line--2 is-italic" data-role="dore" data-lab-line2>Un vrai barbier.</span>
          </p>
          <p class="lab-card-text" data-role="creme">
            Dégradés, barbe, contours. Ton barbier à Bruxelles, au centre-ville et à Uccle.
          </p>
        </div>
      </div>
    </div>

    <p class="lab-palette-label"><span class="lab-on-mouse">Survolez</span><span class="lab-on-touch">Touchez</span> une couleur pour voir où elle vit et copier son code</p>
    <ul class="lab-palette" aria-label="Palette — cliquez pour copier un code couleur">
      {palette.map((color) => (
        <li>
          <button type="button" class="lab-swatch" data-lab-copy={color.hex} data-lab-role={color.role}>
            <span class="lab-swatch-color" style={`background: ${color.hex}`}></span>
            <span class="lab-swatch-text">
              <strong>{color.name}</strong>
              <span class="lab-swatch-hex">{color.hex}</span>
              <span class="lab-swatch-use">{color.use}</span>
            </span>
            <span class="lab-swatch-action" data-lab-action>Copier</span>
          </button>
        </li>
      ))}
    </ul>
    <p class="visually-hidden" aria-live="polite" data-lab-status></p>
  </div>
)}

{section === "development" && (
  <div class="case-extra elm-notes" data-elm-notes data-case-reveal>
    <div class="extra-head extra-head--row">
      <div>
        <span class="extra-kicker">Captures annotées</span>
        <h3 class="extra-title">Ce qui fait le site, point par point</h3>
      </div>
      <div class="notes-tabs" role="tablist" aria-label="Capture affichée">
        {captures.map((capture, index) => (
          <button
            type="button"
            role="tab"
            id={`notes-tab-${capture.id}`}
            aria-controls={`notes-capture-${capture.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-notes-tab={capture.id}
          >
            {capture.label}
          </button>
        ))}
      </div>
    </div>

    {captures.map((capture, captureIndex) => (
      <div
        class="notes-capture"
        id={`notes-capture-${capture.id}`}
        role="tabpanel"
        aria-labelledby={`notes-tab-${capture.id}`}
        data-notes-capture={capture.id}
        hidden={captureIndex !== 0}
      >
        <figure class="notes-figure" style={`aspect-ratio: ${capture.width} / ${capture.height}`} data-notes-figure>
          <!-- Tout ce qui est dans la « scène » zoome ensemble -->
          <div class="notes-stage" data-notes-stage>
            <img
              src={capture.image}
              alt={capture.alt}
              width={capture.width}
              height={capture.height}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            {capture.notes.map((note, index) => (
              <svg class="notes-veil" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-notes-veil={index} hidden={index !== 0}>
                <path d={veilPath(note.zones)} fill-rule="evenodd" />
              </svg>
            ))}
            {capture.notes.map((note, index) =>
              note.zones.map((zone) => (
                <span
                  class={`notes-zone${index === 0 ? " is-active" : ""}`}
                  style={`left: ${zone.x}%; top: ${zone.y}%; width: ${zone.w}%; height: ${zone.h}%`}
                  data-zone-of={index}
                  data-x={zone.x}
                  data-y={zone.y}
                  data-w={zone.w}
                  data-h={zone.h}
                  aria-hidden="true"
                ></span>
              ))
            )}
            {capture.notes.map((note, index) => (
              <button
                type="button"
                class="notes-dot"
                style={`left: ${Math.min(97, Math.max(2.5, note.dot.x))}%; top: ${Math.min(95, Math.max(4, note.dot.y))}%`}
                aria-label={`Note ${index + 1} : ${note.title}`}
                aria-pressed={index === 0 ? "true" : "false"}
                data-notes-dot={index}
              >
                <span>{index + 1}</span>
              </button>
            ))}
          </div>
        </figure>

        <div class="notes-panel">
          <div class="notes-notes">
            {capture.notes.map((note, index) => (
              <div class="notes-note" data-notes-note={index} hidden={index !== 0}>
                <span class="notes-note-index">
                  {String(index + 1).padStart(2, "0")} / {String(capture.notes.length).padStart(2, "0")}
                </span>
                <h4>{note.title}</h4>
                <p>{note.text}</p>
              </div>
            ))}
          </div>
          <div class="notes-nav">
            <button type="button" data-notes-step="-1" aria-label="Note précédente">←</button>
            <button type="button" data-notes-step="1" aria-label="Note suivante">→</button>
            <button type="button" class="notes-zoom" data-notes-zoom aria-pressed="false">
              <span class="notes-zoom-in">Zoomer</span>
              <span class="notes-zoom-out">Vue d'ensemble</span>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>
)}

<script>
  import { initElMagicoExtras } from "../../scripts/elmagico-extras";
  initElMagicoExtras();
</script>

<style>
  /* Les blocs occupent toute la largeur de la section, sous le texte */
  .case-extra {
    grid-column: 1 / -1;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, currentColor 3%, transparent);
  }

  .extra-head {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .extra-head--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .extra-kicker {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .extra-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.15;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ============ Atelier typo & couleurs ============ */

  .lab-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .lab-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lab-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .lab-field span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }
  .lab-field input {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, currentColor 5%, transparent);
    color: inherit;
    font: inherit;
    font-size: 1rem; /* 16px : évite le zoom automatique sur iPhone */
  }
  .lab-field input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .lab-styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lab-styles button {
    padding: 0.55rem 0.95rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-default),
      border-color 0.3s var(--ease-default),
      color 0.3s var(--ease-default);
  }
  .lab-styles button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #141414;
  }

  .lab-hint {
    margin: -0.6rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    opacity: 0.55;
  }

  .lab-fonts {
    display: grid;
    gap: 0.75rem;
    margin: auto 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }
  .lab-fonts div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .lab-fonts dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.55;
  }
  .lab-fonts dd {
    margin: 0;
  }
  .lab-font-serif {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.15rem;
  }
  .lab-font-sans {
    font-family: "Work Sans", system-ui, sans-serif;
    font-size: 0.9rem;
  }

  /* --- Avec / sans la charte --- */
  .lab-switch {
    display: inline-flex;
    padding: 0.25rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 999px;
  }
  .lab-switch button {
    padding: 0.5rem 0.95rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-default),
      color 0.3s var(--ease-default);
  }
  .lab-switch button[aria-pressed="true"] {
    background: var(--accent);
    color: #141414;
  }
  .lab-switch button:focus-visible,
  .lab-styles button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* --- Aperçu : le haut de la page d'accueil du site --- */
  .lab-card {
    --c-bg: #232323;
    --c-gold: #c19a6b;
    --c-cream: #f3ece0;
    --c-white: #ffffff;
    --f-serif: "Cormorant Garamond", Georgia, serif;
    --f-sans: "Work Sans", system-ui, sans-serif;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(18rem, 30vw, 24rem);
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1.1rem, 2.5vw, 2rem) clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 12px;
    overflow: hidden;
    background:
      radial-gradient(90% 70% at 85% 10%, rgba(193, 154, 107, 0.12), transparent 60%),
      var(--c-bg);
    color: var(--c-white);
    font-family: var(--f-sans);
    outline: 1px dashed transparent;
    outline-offset: 5px;
    transition:
      background-color 0.6s var(--ease-default),
      color 0.6s var(--ease-default),
      outline-color 0.3s var(--ease-default);
  }
  /* Sans la charte : couleurs et polices « par défaut » */
  .lab-card.is-plain {
    --c-bg: #ffffff;
    --c-gold: #1a5fd6;
    --c-cream: #555555;
    --c-white: #111111;
    --f-serif: Arial, Helvetica, sans-serif;
    --f-sans: Arial, Helvetica, sans-serif;
    background: var(--c-bg);
  }

  .lab-card [data-role] {
    transition:
      opacity 0.35s var(--ease-default),
      outline-color 0.3s var(--ease-default),
      color 0.6s var(--ease-default),
      border-color 0.6s var(--ease-default),
      background-color 0.6s var(--ease-default);
    outline: 1px dashed transparent;
    outline-offset: 4px;
    border-radius: 3px;
  }

  .lab-card-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    font-size: 0.7rem;
  }
  .lab-card-logo {
    display: grid;
    place-items: center;
    width: 2rem;
