---
// Contenus interactifs propres au projet El Mágico Barber, insérés dans
// l'étude de cas (voir customExtras dans src/pages/projets/[slug].astro) :
//   - section "process"     → l'atelier typo & couleurs
//   - section "development" → les captures annotées
// Pour toute autre section, le composant n'affiche rien.
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/600.css";

interface Props {
  section: string;
}

const { section } = Astro.props;

const palette = [
  { name: "Anthracite", hex: "#232323", use: "Fond", role: "anthracite" },
  { name: "Doré", hex: "#C19A6B", use: "Accents", role: "dore" },
  { name: "Crème", hex: "#F3ECE0", use: "Texte secondaire", role: "creme" },
  { name: "Blanc", hex: "#FFFFFF", use: "Titres", role: "blanc" },
];

const styles = [
  { id: "regular", label: "Regular" },
  { id: "italic", label: "Italique" },
  { id: "semibold", label: "SemiBold" },
];

// Captures annotées : positions des points en % de l'image.
const captures = [
  {
    id: "accueil",
    label: "Accueil",
    image: "/projects/elmagico/galerie-01-accueil.webp",
    width: 2000,
    height: 1029,
    alt: "Page d'accueil du site El Mágico Barber",
    notes: [
      {
        x: 77.5,
        y: 18.5,
        title: "L'heure de Bruxelles, en direct",
        text: "À côté du menu, une petite horloge affiche l'heure de Bruxelles en temps réel. Un détail vivant, qui ancre la marque dans sa ville.",
      },
      {
        x: 90.5,
        y: 18.5,
        title: "Un bouton toujours à portée",
        text: "Le bouton Services, cerclé de doré avec sa flèche dans une pastille pleine, reste visible en haut de chaque page : le visiteur accède aux prestations en un geste.",
      },
      {
        x: 4.5,
        y: 48,
        title: "Deux voix pour un titre",
        text: "Une ligne droite en blanc, une ligne en italique dorée. Le contraste du Cormorant Garamond donne au titre l'élégance d'une enseigne.",
      },
      {
        x: 81,
        y: 40,
        title: "Une carte en verre",
        text: "Le diaporama de photos est posé sur une surface translucide et floutée : on garde le salon visible derrière, sans gêner la lecture. Le compteur 03 / 04 indique où l'on en est.",
      },
      {
        x: 45,
        y: 78,
        title: "Le salon en toile de fond",
        text: "Une vraie photo du salon, assombrie par un voile, sert de décor : le visiteur entre dans le lieu avant même de réserver.",
      },
    ],
  },
  {
    id: "tarifs",
    label: "Tarifs",
    image: "/projects/elmagico/galerie-05-tarifs.webp",
    width: 1400,
    height: 721,
    alt: "Grille tarifaire du site El Mágico Barber",
    notes: [
      {
        x: 34.5,
        y: 21.8,
        title: "D'abord, le salon",
        text: "Deux onglets séparent les salons d'Uccle et du centre-ville. L'onglet actif passe en doré pour que l'on sache toujours où l'on se trouve.",
      },
      {
        x: 30,
        y: 35,
        title: "Puis, le barbier",
        text: "Les tarifs varient d'un professionnel à l'autre. Le visiteur choisit son barbier et la grille se met à jour, sans changer de page.",
      },
      {
        x: 23,
        y: 46.7,
        title: "Trois familles de prestations",
        text: "Coupes et barbes, soins et détente, techniques : les prestations sont rangées en colonnes, comme sur la carte d'un restaurant.",
      },
      {
        x: 77,
        y: 70,
        title: "Une carte claire sur fond sombre",
        text: "La grille est posée sur un fond crème au milieu de la page anthracite : elle se détache et se lit comme un vrai menu.",
      },
    ],
  },
];
---

{section === "process" && (
  <div class="case-extra elm-lab" data-elm-lab data-case-reveal>
    <div class="extra-head extra-head--row">
      <div>
        <span class="extra-kicker">Atelier</span>
        <h3 class="extra-title">Essayez la charte El Mágico</h3>
      </div>
      <!-- Avec / sans la charte : montre ce que l'identité apporte -->
      <div class="lab-switch" role="group" aria-label="Affichage de l'aperçu">
        <button type="button" data-lab-theme="brand" aria-pressed="true">Avec la charte</button>
        <button type="button" data-lab-theme="plain" aria-pressed="false">Sans la charte</button>
      </div>
    </div>

    <div class="lab-grid">
      <div class="lab-controls">
        <label class="lab-field">
          <span>Votre titre</span>
          <input
            type="text"
            value="Une coupe nette. Un vrai barbier."
            maxlength="60"
            autocomplete="off"
            spellcheck="false"
            data-lab-input
          />
        </label>
        <p class="lab-hint">Un point sépare les deux lignes du titre, comme sur le site.</p>

        <div class="lab-field">
          <span>Seconde ligne</span>
          <div class="lab-styles" role="group" aria-label="Style de la seconde ligne">
            {styles.map((style, index) => (
              <button type="button" data-lab-style={style.id} aria-pressed={index === 1 ? "true" : "false"}>
                {style.label}
              </button>
            ))}
          </div>
        </div>

        <dl class="lab-fonts">
          <div>
            <dt>Titres</dt>
            <dd class="lab-font-serif">Cormorant Garamond</dd>
          </div>
          <div>
            <dt>Texte courant</dt>
            <dd class="lab-font-sans">Work Sans</dd>
          </div>
        </dl>
      </div>

      <!-- Aperçu : le haut de la page d'accueil, reconstruit en HTML -->
      <div class="lab-card is-brand" data-lab-card data-role="anthracite" aria-label="Aperçu de la page d'accueil">
        <div class="lab-card-nav">
          <span class="lab-card-logo" data-role="dore" aria-hidden="true">EM</span>
          <span class="lab-card-links" data-role="creme">Réservation&nbsp;&nbsp;LookBook&nbsp;&nbsp;À propos</span>
          <span class="lab-card-clock" data-role="creme">BXL&nbsp;<span data-lab-clock>--:--</span></span>
          <span class="lab-card-button" data-role="dore">
            <span>Services</span>
            <span class="lab-card-button-dot" aria-hidden="true">→</span>
          </span>
        </div>
        <div class="lab-card-body">
          <span class="lab-card-kicker" data-role="creme">Barber shop — Bruxelles</span>
          <p class="lab-card-title">
            <span class="lab-card-line" data-role="blanc" data-lab-line1>Une coupe nette.</span>
            <span class="lab-card-line lab-card-line--2 is-italic" data-role="dore" data-lab-line2>Un vrai barbier.</span>
          </p>
          <p class="lab-card-text" data-role="creme">
            Dégradés, barbe, contours. Ton barbier à Bruxelles, au centre-ville et à Uccle.
          </p>
        </div>
      </div>
    </div>

    <p class="lab-palette-label"><span class="lab-on-mouse">Survolez</span><span class="lab-on-touch">Touchez</span> une couleur pour voir où elle vit et copier son code</p>
    <ul class="lab-palette" aria-label="Palette — cliquez pour copier un code couleur">
      {palette.map((color) => (
        <li>
          <button type="button" class="lab-swatch" data-lab-copy={color.hex} data-lab-role={color.role}>
            <span class="lab-swatch-color" style={`background: ${color.hex}`}></span>
            <span class="lab-swatch-text">
              <strong>{color.name}</strong>
              <span class="lab-swatch-hex">{color.hex}</span>
              <span class="lab-swatch-use">{color.use}</span>
            </span>
            <span class="lab-swatch-action" data-lab-action>Copier</span>
          </button>
        </li>
      ))}
    </ul>
    <p class="visually-hidden" aria-live="polite" data-lab-status></p>
  </div>
)}

{section === "development" && (
  <div class="case-extra elm-notes" data-elm-notes data-case-reveal>
    <div class="extra-head extra-head--row">
      <div>
        <span class="extra-kicker">Captures annotées</span>
        <h3 class="extra-title">Les choix de design, point par point</h3>
      </div>
      <div class="notes-tabs" role="tablist" aria-label="Capture affichée">
        {captures.map((capture, index) => (
          <button
            type="button"
            role="tab"
            id={`notes-tab-${capture.id}`}
            aria-controls={`notes-capture-${capture.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            data-notes-tab={capture.id}
          >
            {capture.label}
          </button>
        ))}
      </div>
    </div>

    {captures.map((capture, captureIndex) => (
      <div
        class="notes-capture"
        id={`notes-capture-${capture.id}`}
        role="tabpanel"
        aria-labelledby={`notes-tab-${capture.id}`}
        data-notes-capture={capture.id}
        hidden={captureIndex !== 0}
      >
        <figure class="notes-figure">
          <img
            src={capture.image}
            alt={capture.alt}
            width={capture.width}
            height={capture.height}
            loading="lazy"
            decoding="async"
          />
          {capture.notes.map((note, index) => (
            <button
              type="button"
              class="notes-dot"
              style={`left: ${note.x}%; top: ${note.y}%`}
              aria-label={`Note ${index + 1} : ${note.title}`}
              aria-pressed={index === 0 ? "true" : "false"}
              data-notes-dot={index}
            >
              <span>{index + 1}</span>
            </button>
          ))}
        </figure>

        <div class="notes-panel">
          {capture.notes.map((note, index) => (
            <div class="notes-note" data-notes-note={index} hidden={index !== 0}>
              <span class="notes-note-index">
                {String(index + 1).padStart(2, "0")} / {String(capture.notes.length).padStart(2, "0")}
              </span>
              <h4>{note.title}</h4>
              <p>{note.text}</p>
            </div>
          ))}
          <div class="notes-nav">
            <button type="button" data-notes-step="-1" aria-label="Note précédente">←</button>
            <button type="button" data-notes-step="1" aria-label="Note suivante">→</button>
          </div>
        </div>
      </div>
    ))}
  </div>
)}

<script>
  import { initElMagicoExtras } from "../../scripts/elmagico-extras";
  initElMagicoExtras();
</script>

<style>
  /* Les blocs occupent toute la largeur de la section, sous le texte */
  .case-extra {
    grid-column: 1 / -1;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, currentColor 3%, transparent);
  }

  .extra-head {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .extra-head--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .extra-kicker {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .extra-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.15;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ============ Atelier typo & couleurs ============ */

  .lab-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .lab-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lab-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .lab-field span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }
  .lab-field input {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, currentColor 5%, transparent);
    color: inherit;
    font: inherit;
    font-size: 1rem; /* 16px : évite le zoom automatique sur iPhone */
  }
  .lab-field input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .lab-styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lab-styles button {
    padding: 0.55rem 0.95rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-default),
      border-color 0.3s var(--ease-default),
      color 0.3s var(--ease-default);
  }
  .lab-styles button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #141414;
  }

  .lab-hint {
    margin: -0.6rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    opacity: 0.55;
  }

  .lab-fonts {
    display: grid;
    gap: 0.75rem;
    margin: auto 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }
  .lab-fonts div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .lab-fonts dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.55;
  }
  .lab-fonts dd {
    margin: 0;
  }
  .lab-font-serif {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.15rem;
  }
  .lab-font-sans {
    font-family: "Work Sans", system-ui, sans-serif;
    font-size: 0.9rem;
  }

  /* --- Avec / sans la charte --- */
  .lab-switch {
    display: inline-flex;
    padding: 0.25rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 999px;
  }
  .lab-switch button {
    padding: 0.5rem 0.95rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-default),
      color 0.3s var(--ease-default);
  }
  .lab-switch button[aria-pressed="true"] {
    background: var(--accent);
    color: #141414;
  }
  .lab-switch button:focus-visible,
  .lab-styles button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* --- Aperçu : le haut de la page d'accueil du site --- */
  .lab-card {
    --c-bg: #232323;
    --c-gold: #c19a6b;
    --c-cream: #f3ece0;
    --c-white: #ffffff;
    --f-serif: "Cormorant Garamond", Georgia, serif;
    --f-sans: "Work Sans", system-ui, sans-serif;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(18rem, 30vw, 24rem);
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1.1rem, 2.5vw, 2rem) clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 12px;
    overflow: hidden;
    background:
      radial-gradient(90% 70% at 85% 10%, rgba(193, 154, 107, 0.12), transparent 60%),
      var(--c-bg);
    color: var(--c-white);
    font-family: var(--f-sans);
    outline: 1px dashed transparent;
    outline-offset: 5px;
    transition:
      background-color 0.6s var(--ease-default),
      color 0.6s var(--ease-default),
      outline-color 0.3s var(--ease-default);
  }
  /* Sans la charte : couleurs et polices « par défaut » */
  .lab-card.is-plain {
    --c-bg: #ffffff;
    --c-gold: #1a5fd6;
    --c-cream: #555555;
    --c-white: #111111;
    --f-serif: Arial, Helvetica, sans-serif;
    --f-sans: Arial, Helvetica, sans-serif;
    background: var(--c-bg);
  }

  .lab-card [data-role] {
    transition:
      opacity 0.35s var(--ease-default),
      outline-color 0.3s var(--ease-default),
      color 0.6s var(--ease-default),
      border-color 0.6s var(--ease-default),
      background-color 0.6s var(--ease-default);
    outline: 1px dashed transparent;
    outline-offset: 4px;
    border-radius: 3px;
  }

  .lab-card-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    font-size: 0.7rem;
  }
  .lab-card-logo {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--c-gold);
    border-radius: 50% !important;
    color: var(--c-gold);
    font-family: var(--f-serif);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }
  .lab-card-links {
    color: var(--c-cream);
    font-family: var(--f-serif);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .lab-card-clock {
    margin-left: auto;
    color: var(--c-cream);
    font-family: var(--f-serif);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lab-card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.3rem 0.3rem 0.85rem;
    border: 1px solid var(--c-gold);
    border-radius: 999px !important;
    color: var(--c-white);
    font-family: var(--f-serif);
    font-size: 0.85rem;
  }
  .lab-card-button-dot {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--c-gold);
    color: var(--c-bg);
    font-size: 0.7rem;
    transition: background-color 0.6s var(--ease-default), color 0.6s var(--ease-default);
  }

  .lab-card-body {
    margin-top: auto;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }
  .lab-card-kicker {
    display: inline-block;
    margin-bottom: 0.9rem;
    color: var(--c-cream);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
  }
  .lab-card-title {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--f-serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 4.2vw, 3.3rem);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .lab-card-line {
    align-self: flex-start;
    color: var(--c-white);
  }
  .lab-card-line--2 {
    color: var(--c-white);
  }
  .lab-card-line--2.is-italic {
    font-style: italic;
    color: var(--c-gold);
  }
  .lab-card-line--2.is-semibold {
    font-weight: 600;
  }
  .lab-card-line:empty {
    display: none;
  }
  .lab-card-text {
    max-width: 26rem;
    margin: 1rem 0 0;
    color: var(--c-cream);
    font-size: 0.82rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  /* --- Couleur survolée : on montre où elle est utilisée --- */
  .lab-card[data-spot] [data-role] {
    opacity: 0.18;
  }
  .lab-card[data-spot="dore"] [data-role="dore"],
  .lab-card[data-spot="creme"] [data-role="creme"],
  .lab-card[data-spot="blanc"] [data-role="blanc"] {
    opacity: 1;
    outline-color: var(--c-gold);
  }
  .lab-card[data-spot="creme"] [data-role="creme"],
  .lab-card[data-spot="blanc"] [data-role="blanc"] {
    outline-color: var(--c-cream);
  }
  /* Le fond : c'est toute la carte qu'on encadre */
  .lab-card[data-spot="anthracite"] {
    outline-color: var(--accent);
  }

  .lab-palette-label {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.55;
  }
  .lab-on-touch {
    display: none;
  }
  @media (hover: none) {
    .lab-on-mouse {
      display: none;
    }
    .lab-on-touch {
      display: inline;
    }
  }
  .lab-palette {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lab-swatch {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0.25rem 0.85rem;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 10px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-default);
  }
  .lab-swatch:hover,
  .lab-swatch:focus-visible {
    border-color: var(--accent);
  }
  .lab-swatch:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lab-swatch-color {
    grid-row: 1 / 3;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
