---
// Contenus interactifs propres à Kararra (page projet).
//   - section "development" → l'évaluateur, en version simplifiée
//
// Mêmes formules que le moteur de l'application (engine.ts) et mêmes
// réglages que la marque (marges, budget). Les calculs sont dans
// src/scripts/kararra-simulator.js.

interface Props {
  section: string;
}

const { section } = Astro.props;

import AnnotatedCaptures, { type Capture } from "../AnnotatedCaptures.astro";

// --- 02 : anatomie du coût réel (exemple réel de l'application :
// plateau en travertin, 100 unités, vendu 69 € HT) ---
const anatomy = {
  product: "Plateau travertin T-104",
  price: 69,
  parts: [
    { id: "achat", label: "Prix d'achat", value: 18, text: "Le prix du fournisseur pour la quantité commandée, selon ses paliers dégressifs, converti en euros." },
    { id: "fret", label: "Transport réparti", value: 1.2, text: "Le fret est estimé à partir du volume et du poids des cartons (maritime ou aérien, avec un forfait minimum), puis réparti sur chaque unité." },
    { id: "douane", label: "Douane", value: 0, text: "Un taux appliqué au prix d'achat et au transport. Pour ce produit, il n'y en a pas." },
    { id: "dedouanement", label: "Dédouanement", value: 0.6, text: "Les frais de dédouanement de l'expédition, répartis sur la quantité commandée." },
    { id: "packaging", label: "Packaging", value: 1.5, text: "L'emballage de chaque pièce avant la revente." },
    { id: "autres", label: "Autres frais", value: 0.6, text: "Tout le reste, par unité. Un frais inconnu n'est jamais inventé : il est signalé comme manquant." },
  ],
  marginText: "Ce qui reste une fois le coût réel payé. La TVA, récupérable pour la marque, n'entre pas dans le coût.",
};
const anatomyCost = anatomy.parts.reduce((sum, part) => sum + part.value, 0);
const euro = (n: number) => n.toLocaleString("fr-FR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €";

