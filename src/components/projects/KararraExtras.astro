];


const tiers = [
  { id: "materialTier", label: "Matière" },
  { id: "paletteTier", label: "Palette" },
  { id: "styleTier", label: "Style" },
];

const tierOptions = [
  { value: "coeur", label: "Cœur de marque" },
  { value: "peripherie", label: "Périphérie" },
  { value: "hors_univers", label: "Hors univers" },
];

// Curseurs : id, libellé, min, max, pas, unité
const priceSliders = [
  { id: "purchase", label: "Prix d'achat", min: 2, max: 60, step: 0.5, unit: "€" },
  { id: "fees", label: "Transport & frais d'import", min: 0, max: 20, step: 0.1, unit: "€ / u" },
  { id: "price", label: "Prix de vente HT", min: 10, max: 150, step: 1, unit: "€" },
  { id: "qty", label: "Quantité commandée", min: 10, max: 300, step: 10, unit: "u" },
];
const scoreSliders = [
  { id: "quality", label: "Qualité", min: 0, max: 100, step: 5, unit: "/ 100" },
  { id: "originality", label: "Originalité", min: 0, max: 100, step: 5, unit: "/ 100" },
  { id: "reliability", label: "Fiabilité fournisseur", min: 0, max: 100, step: 5, unit: "/ 100" },
  { id: "risk", label: "Niveau de risque", min: 0, max: 100, step: 5, unit: "/ 100" },
];

const subScores = [
  { id: "coherence", label: "Cohérence Kararra" },
  { id: "profitability", label: "Rentabilité" },
  { id: "quality", label: "Qualité" },
  { id: "moq_investment", label: "Investissement" },
  { id: "originality", label: "Originalité" },
  { id: "supplier_reliability", label: "Fiabilité fournisseur" },
  { id: "logistics", label: "Logistique" },
  { id: "risk", label: "Risque" },
];

// Exemples prêts à l'emploi (produits fictifs)
const presets = [
  { id: "travertin", label: "Plateau en travertin" },
  { id: "bougie", label: "Bougie parfumée" },
  { id: "vase", label: "Vase coloré" },
];
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Montserrat:wght@400;500;600&display=swap"
/>

{section === "challenge" && (
  <div class="case-extra kar-anatomy" data-kararra-anatomy data-case-reveal>
    <div class="extra-head extra-head--row">
      <div>
        <span class="extra-kicker">Anatomie d'un prix</span>
        <h3 class="extra-title">Ce que coûte vraiment un objet</h3>
      </div>
      <div class="ana-switch" role="group" aria-label="Affichage">
        <button type="button" data-ana-view="cost" aria-pressed="true">Coût réel</button>
        <button type="button" data-ana-view="price" aria-pressed="false">Prix de vente</button>
      </div>
    </div>

    <p class="ana-product">
      {anatomy.product} · 100 unités · vendu {euro(anatomy.price)} HT
    </p>

    <div class="ana-total">
      <span data-ana-total-label>Coût réel par unité</span>
      <strong data-ana-total>{euro(anatomyCost)}</strong>
    </div>

    <!-- La barre : chaque segment est proportionnel à son montant -->
    <div class="ana-bar" data-ana-bar data-view="cost">
      {anatomy.parts.filter((p) => p.value > 0).map((part) => (
        <button
          type="button"
          class={`ana-seg ana-seg--${part.id}`}
          style={`--v: ${part.value}`}
          data-ana-part={part.id}
          aria-label={`${part.label} : ${euro(part.value)}`}
        ></button>
      ))}
      <button
        type="button"
        class="ana-seg ana-seg--marge"
        style={`--v: ${anatomy.price - anatomyCost}`}
        data-ana-part="marge"
        aria-label={`Marge : ${euro(anatomy.price - anatomyCost)}`}
      ></button>
    </div>

    <div class="ana-grid">
      <ul class="ana-legend">
        {anatomy.parts.map((part) => (
          <li>
            <button type="button" data-ana-part={part.id} aria-pressed={part.id === "achat" ? "true" : "false"}>
              <span class={`ana-swatch ana-seg--${part.id}`}></span>
              <span class="ana-legend-label">{part.label}</span>
              <span class="ana-legend-value">{euro(part.value)}</span>
            </button>
          </li>
        ))}
        <li class="ana-legend-margin">
          <button type="button" data-ana-part="marge" aria-pressed="false">
            <span class="ana-swatch ana-seg--marge"></span>
            <span class="ana-legend-label">Marge</span>
            <span class="ana-legend-value">{euro(anatomy.price - anatomyCost)}</span>
          </button>
        </li>
      </ul>

      <div class="ana-detail" aria-live="polite">
        {anatomy.parts.map((part, index) => (
          <div class="ana-note" data-ana-note={part.id} hidden={index !== 0}>
            <span class="ana-note-share" data-ana-share={part.value}></span>
            <h4>{part.label} — {euro(part.value)}</h4>
            <p>{part.text}</p>
          </div>
        ))}
        <div class="ana-note" data-ana-note="marge" hidden>
          <span class="ana-note-share" data-ana-share={anatomy.price - anatomyCost}></span>
          <h4>Marge — {euro(anatomy.price - anatomyCost)}</h4>
          <p>{anatomy.marginText}</p>
        </div>
      </div>
    </div>
    <script type="application/json" data-ana-data set:html={JSON.stringify({ cost: anatomyCost, price: anatomy.price })}></script>
  </div>
)}

{section === "process" && (
  <div class="case-extra kar-universe" data-kararra-universe data-case-reveal>
    <div class="extra-head">
      <span class="extra-kicker">L'univers Kararra</span>
      <h3 class="extra-title">Composez un objet, voyez s'il est « Kararra »</h3>
    </div>

    <div class="uni-grid">
      <div class="uni-columns">
        {universe.map((group) => (
          <div class="uni-col" role="radiogroup" aria-label={group.label}>
            <span class="uni-col-title">{group.label}</span>
            {group.items.map((item, index) => (
              <button
                type="button"
                role="radio"
                class={`uni-chip uni-chip--${item.tier}`}
                aria-checked={index === 0 ? "true" : "false"}
                data-uni-group={group.id}
                data-uni-name={item.name}
                data-uni-tier={item.tier}
              >
                <span>{item.name}</span>
                <span class="uni-chip-tier">{tierLabel[item.tier]}</span>
              </button>
            ))}
          </div>
        ))}
      </div>

      <div class="uni-result" aria-live="polite">
        <span class="uni-result-kicker">Cohérence Kararra</span>
        <strong class="uni-score"><span data-uni-score>—</span><small>/ 100</small></strong>
        <span class="uni-meter"><span data-uni-meter></span></span>
        <p class="uni-object" data-uni-object></p>
        <p class="uni-verdict" data-uni-verdict></p>
        <ul class="uni-key">
          <li><span class="uni-dot uni-dot--coeur"></span>Cœur de marque</li>
          <li><span class="uni-dot uni-dot--peripherie"></span>Périphérie</li>
          <li><span class="uni-dot uni-dot--hors_univers"></span>Hors univers</li>
        </ul>
      </div>
    </div>
  </div>
)}

{section === "development" && (
  <div class="case-extra kar-sim" data-kararra-sim data-case-reveal>
    <div class="extra-head extra-head--row">
      <div>
        <span class="extra-kicker">Évaluateur</span>
        <h3 class="extra-title">Faites passer un objet à l'examen</h3>
      </div>
      <div class="sim-presets" role="group" aria-label="Exemples de produits">
        {presets.map((preset, index) => (
          <button type="button" data-sim-preset={preset.id} aria-pressed={index === 0 ? "true" : "false"}>
            {preset.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Fenêtre façon application -->
    <div class="sim-app">
      <div class="sim-bar" aria-hidden="true">
        <span class="sim-brand">Kararra <em>Evaluator</em></span>
        <span class="sim-dots"><i></i><i></i><i></i></span>
      </div>

      <div class="sim-grid">
        <!-- Saisie -->
        <form class="sim-form" data-sim-form onsubmit="return false">
          <div class="sim-group" role="group" aria-labelledby="sim-group-0">
            <p class="sim-group-title" id="sim-group-0">Prix &amp; coûts</p>
            {priceSliders.map((s) => (
              <label class="sim-range">
                <span class="sim-range-head">
                  <span>{s.label}</span>
                  <output data-sim-out={s.id}></output>
                </span>
                <input type="range" name={s.id} min={s.min} max={s.max} step={s.step} data-unit={s.unit} />
              </label>
            ))}
          </div>

          <div class="sim-group" role="group" aria-labelledby="sim-group-1">
            <p class="sim-group-title" id="sim-group-1">Univers de la marque</p>
            <div class="sim-tiers">
              {tiers.map((t) => (
                <label class="sim-select">
                  <span>{t.label}</span>
                  <select name={t.id}>
                    {tierOptions.map((o) => <option value={o.value}>{o.label}</option>)}
                  </select>
                </label>
              ))}
            </div>
          </div>

          <div class="sim-group" role="group" aria-labelledby="sim-group-2">
            <p class="sim-group-title" id="sim-group-2">Appréciation</p>
            {scoreSliders.map((s) => (
              <label class="sim-range">
                <span class="sim-range-head">
                  <span>{s.label}</span>
                  <output data-sim-out={s.id}></output>
                </span>
                <input type="range" name={s.id} min={s.min} max={s.max} step={s.step} data-unit={s.unit} />
              </label>
            ))}
          </div>
        </form>

        <!-- Résultat -->
        <div class="sim-result" aria-live="polite">
          <div class="sim-decision" data-sim-decision>
            <div>
              <span class="sim-decision-kicker">Décision</span>
              <strong class="sim-decision-label" data-sim-band>—</strong>
            </div>
            <div class="sim-score">
              <strong data-sim-score>—</strong>
              <span>score / 100</span>
            </div>
          </div>
          <p class="sim-reason" data-sim-reason></p>

          <dl class="sim-kpis">
            <div><dt>Coût réel</dt><dd data-sim-landed>—</dd></div>
            <div><dt>Marge</dt><dd data-sim-margin>—</dd></div>
            <div><dt>Prix d'achat max</dt><dd data-sim-maxbuy>—</dd></div>
            <div><dt>Cash requis</dt><dd data-sim-cash>—</dd></div>
          </dl>

          <div class="sim-scores">
            <span class="sim-scores-title">Score détaillé</span>
            {subScores.map((s) => (
              <div class="sim-bar-row" data-sim-sub={s.id}>
                <span>{s.label}</span>
                <span class="sim-track"><span class="sim-fill"></span></span>
                <span class="sim-value">—</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <p class="sim-note">
      Version simplifiée de l'évaluateur : mêmes formules que l'application, avec les marges et le budget
      de la marque (marge plancher 40 %, cible 60 %, excellente 80 %, budget de 5 000 €). Les produits sont fictifs.
    </p>
  </div>
)}

{section === "outcome" && (
  <AnnotatedCaptures captures={captures} kicker="Captures annotées" title="L'application, écran par écran" />
)}

<script>
  import { initKararraSimulator, initCostAnatomy, initUniverse } from "../../scripts/kararra-simulator";
  initKararraSimulator();
  initCostAnatomy();
  initUniverse();
</script>

<style>
  /* --- Bloc commun aux contenus sur mesure --- */
