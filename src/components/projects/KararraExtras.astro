    grid-column: 1 / -1;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, currentColor 3%, transparent);
  }
  .extra-head {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .extra-head--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .extra-kicker {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .extra-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.15;
  }

  /* --- Exemples --- */
  .sim-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sim-presets button {
    padding: 0.5rem 0.95rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: background-color 0.3s var(--ease-default), border-color 0.3s var(--ease-default), color 0.3s var(--ease-default);
  }
  .sim-presets button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .sim-presets button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* --- Fenêtre de l'application (palette Kararra) --- */
  .sim-app {
    --k-paper: #f5ede1;
    --k-surface: #fffdf9;
    --k-field: #fbf4ea;
    --k-ink: #2c201a;
    --k-soft: #5a4a3e;
    --k-muted: #8c7b6b;
    --k-hair: #e6d7c3;
    --k-terra: #b4703f;
    --k-terra-deep: #8a5230;
    --k-green: #5e7a4e;
    --k-amber: #b98327;
    --k-red: #a83a2b;
    --k-serif: "Playfair Display", Georgia, serif;
