---
interface Props {
  type: "intro" | "story" | "skill";
  title?: string;
  body: string;
  tools?: string[];
  backgroundColor: string;
  textColor: string;
  dark?: boolean;
  index: number;
  skillMenuIndex?: number;
}
const {
  type, title, body, tools = [], backgroundColor, textColor,
  dark = false, index, skillMenuIndex = -1,
} = Astro.props;
---

<section class="story-section" data-index={index} data-dark={dark ? "true" : "false"} data-skill-menu-index={skillMenuIndex}>
  <div
    class="story-panel"
    style={`--panel-bg: ${backgroundColor}; --panel-color: ${textColor}; z-index: ${index + 1};`}
  >
    <div class="story-panel-inner">
      {type === "intro" && <span class="story-panel-eyebrow">Zanith — Agence digitale</span>}
      {title && <h2 class="story-panel-title">{title}</h2>}
      <p class:list={["story-panel-body", { "story-panel-body--lede": type !== "skill" }]}>{body}</p>
      {tools.length > 0 && (
        <ul class="story-panel-tools">
          {tools.map((t) => <li>{t}</li>)}
        </ul>
      )}
      <div class="story-panel-extra">
        <slot />
      </div>
    </div>

    {type === "intro" && (
      <span class="story-panel-cue" aria-hidden="true">
        <span class="story-panel-cue-line"></span>
        <span class="story-panel-cue-arrow">↓</span>
      </span>
    )}
  </div>
</section>

<style>
  .story-section { position: relative; height: 200vh; }
  .story-section[data-index="0"] { height: 100vh; }

  .story-panel {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--panel-bg);
    color: var(--panel-color);
    will-change: clip-path;
  }

  .story-panel-inner {
    position: relative; width: 100%; max-width: 760px;
    padding: 0 var(--container-padding); text-align: center;
  }

  .story-panel-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .story-panel-title {
    font-weight: 300; letter-spacing: -0.01em;
    font-size: clamp(2.5rem, 7vw, 6rem); margin: 0 0 1.5rem;
  }
  .story-panel-body {
    font-size: 1rem; line-height: 1.7;
    max-width: 560px; margin: 0 auto 2rem; opacity: 0.85;
  }
  .story-panel-body--lede {
    font-size: clamp(1.4rem, 3vw, 2.2rem); font-weight: 300;
    line-height: 1.5; max-width: 680px; opacity: 1;
  }
  .story-panel-tools {
    list-style: none; margin: 0 0 2rem; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .story-panel-tools li {
    border: 1px solid color-mix(in srgb, var(--panel-color) 30%, transparent);
    padding: 0.35rem 0.75rem; border-radius: 999px;
  }
  .story-panel-extra:empty { display: none; }

  .story-panel-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.5;
    animation: story-cue-bounce 2s ease-in-out infinite;
  }
  .story-panel-cue-line { width: 1px; height: 32px; background: currentColor; opacity: 0.5; }
  .story-panel-cue-arrow { font-size: 0.9rem; }

  @keyframes story-cue-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (max-width: 900px) {
    .story-section { height: 140vh; }
    .story-section[data-index="0"] { height: 100vh; }
  }
</style>