---
interface Props {
  startInIntro?: boolean;
  variant?: "light" | "dark";
  pageLabel?: string;
}
const { startInIntro = false, variant = "light", pageLabel } = Astro.props;
const teeth = Array.from({ length: 12 });

const navItems = [
  { label: "Travail", href: "/" },
  { label: "Compétences", href: "/competences" },
  { label: "Contact", href: "/contact" },
];
// Le menu n'affiche jamais la page sur laquelle on se trouve déjà.
const menuItems = navItems.filter((item) => item.label !== pageLabel);
// Pendant l'intro seulement : l'item courant reste temporairement dans
// le menu (tout le monde y est au chargement), avant de basculer vers
// le centre à la fin de l'animation (voir intro.js).
const introExtraItem = startInIntro ? navItems.find((item) => item.label === pageLabel) : null;
---

<header id="site-header" class:list={["site-header", { "is-intro": startInIntro, "is-dark-bg": variant === "dark" }]}>
  <div class="header-inner">
    <div class="brand-group">
      <a href="/" class="brand" data-intro-item>Zanith</a>
      <p class="name" data-intro-item> //Nadir Gherich// </p>
    </div>

    {pageLabel && <p class="page-label" id="page-label">{pageLabel}</p>}

    <nav class="menu" aria-label="Navigation principale">
      {introExtraItem && (
        <a href={introExtraItem.href} id="intro-extra-menu-item" data-intro-item>{introExtraItem.label}</a>
      )}
      {menuItems.map((item) => (
        <a href={item.href} data-intro-item>{item.label}</a>
      ))}
    </nav>

    <!-- Mobile : un seul bouton à la place des liens (voir menu plein écran) -->
    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-intro-item
    >Menu</button>
  </div>

  <!--
    Menu plein écran (mobile uniquement). Contrairement au menu du haut,
    il liste TOUTES les pages, y compris celle où l'on se trouve
    (marquée), pour que le visiteur sache toujours où il est.
  -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-menu-nav" aria-label="Navigation principale (mobile)">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          class="mobile-menu-link"
          style={`--i: ${index}`}
          aria-current={item.label === pageLabel ? "page" : undefined}
          tabindex="-1"
        >
          <span class="mobile-menu-index">{String(index + 1).padStart(2, "0")}</span>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="mobile-menu-footer" style={`--i: ${navItems.length}`}>
      <a href="mailto:contact@zanith.be" tabindex="-1">contact@zanith.be</a>
      <span>Bruxelles</span>
    </div>
  </div>

  {startInIntro && (
    <svg id="intro-gear" class="loader-gear" viewBox="0 0 100 100" aria-hidden="true">
      <circle class="loader-gear-ring" cx="50" cy="50" r="30" />
      {teeth.map((_, i) => (
        <rect class="loader-gear-tooth" x="46" y="2" width="8" height="14" rx="1" transform={`rotate(${i * 30} 50 50)`} />
      ))}
      <circle class="loader-gear-center" cx="50" cy="50" r="6" />
    </svg>
  )}
</header>

<script>
  // Menu plein écran mobile : ouverture/fermeture, scroll bloqué
  // pendant qu'il est ouvert, fermeture à Échap, focus géré.
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-menu");

  if (header && toggle && panel) {
    const links = panel.querySelectorAll("a");
    let open = false;

    const setOpen = (value) => {
      open = value;
      header.classList.toggle("is-menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Fermer" : "Menu";
      panel.setAttribute("aria-hidden", String(!open));
      links.forEach((link) => (link.tabIndex = open ? 0 : -1));

      // Défilement bloqué pendant que le menu est ouvert (Lenis + natif)
      const lenis = (window as any).__lenis;
      if (open) {
        lenis?.stop();
        document.documentElement.style.overflow = "hidden";
        links[0]?.focus({ preventScroll: true });
      } else {
        lenis?.start();
        document.documentElement.style.overflow = "";
      }
    };

    toggle.addEventListener("click", () => {
      // Pas d'ouverture pendant l'intro de l'accueil
      if (header.classList.contains("is-intro")) return;
      setOpen(!open);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && open) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Retour au format ordinateur (rotation, fenêtre élargie) : on ferme.
    window.matchMedia("(min-width: 641px)").addEventListener("change", (event) => {
      if (event.matches && open) setOpen(false);
    });

    // Retour arrière vers une page restée en mémoire avec le menu ouvert
    window.addEventListener("pageshow", (event) => {
      if (event.persisted && open) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--text-primary);
    height: 80px;
    padding: 0 var(--container-padding);
    background: transparent;
    transition: color 0.4s var(--ease-default);
  }
  .site-header.is-dark-bg { color: var(--text-inverse); }

  .header-inner {
    position: relative;
    display: flex; align-items: center; justify-content: space-between;
    height: 100%; max-width: 1600px; margin: 0 auto;
  }
  .brand-group { display: flex; align-items: baseline; gap: 0.75rem; }
  .brand, .name { margin: 0; font-size: 0.85rem; text-decoration: none; }
  .menu { display: flex; gap: 1.5rem; font-size: 0.85rem; }
  .menu a { text-decoration: none; opacity: 0.75; }
  .menu a:hover { opacity: 1; }

  .page-label {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    margin: 0; font-size: 0.85rem;
  }

  .site-header.is-intro {
    height: 100vh;
    height: 100svh;
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .loader-gear {
    position: fixed; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 40px; height: 40px;
    color: var(--text-primary);
    opacity: 0;
    animation: spin 1.8s linear infinite;
  }
  .loader-gear-ring { fill: none; stroke: currentColor; stroke-width: 4; }
  .loader-gear-tooth, .loader-gear-center { fill: currentColor; }
  @keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }

  /* --- Mobile ---
     Sous ~640px, "Zanith" + "//Nadir Gherich//" + le page-label centré
     en position absolute + 2 liens de nav ne tiennent plus dans une
     bande de 80px sans se chevaucher. On retire le nom secondaire
     (déjà peu utile hors intro) et on resserre la nav. Le page-label
     est centré en absolute indépendamment du flex du reste : une fois
     la nav condensée, rien ne garantit qu'il reste dans l'espace libre
     entre brand et menu selon la longueur du libellé ("Compétences"
     est plus long que "Contact") — on le masque plutôt que de risquer
     un chevauchement visuel ; l'info de page courante reste disponible
     via le contenu de la page elle-même. */
  /* ============ Menu mobile ============ */

  .menu-toggle {
    display: none;
    margin: 0;
    padding: 0.6rem 0 0.6rem 1rem; /* zone de toucher confortable */
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: none;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(80px + 2.5rem) var(--container-padding) calc(2rem + env(safe-area-inset-bottom));
    background: var(--color-night);
    color: var(--color-cream);
    /* Rideau qui descend depuis le haut */
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.6s var(--ease-default),
      visibility 0s linear 0.6s;
  }

  .header-inner {
    z-index: 2; /* logo et bouton restent au-dessus du menu ouvert */
  }

  .site-header.is-menu-open {
    color: var(--color-cream);
  }

  .site-header.is-menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition: clip-path 0.6s var(--ease-default);
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mobile-menu-link,
  .mobile-menu-footer {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.3s var(--ease-default),
      transform 0.3s var(--ease-default);
  }

  .site-header.is-menu-open .mobile-menu-link,
  .site-header.is-menu-open .mobile-menu-footer {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s var(--ease-default) calc(0.25s + var(--i) * 0.07s),
      transform 0.5s var(--ease-default) calc(0.25s + var(--i) * 0.07s);
  }

  .mobile-menu-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 12vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: none;
    text-decoration: none;
  }

  .mobile-menu-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  /* Page actuelle : atténuée, marquée d'un point */
  .mobile-menu-link[aria-current="page"] {
    opacity: 0.4;
  }
  .site-header.is-menu-open .mobile-menu-link[aria-current="page"] {
    opacity: 0.4;
  }
  .mobile-menu-link[aria-current="page"]::after {
    content: "";
    align-self: center;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .mobile-menu-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .site-header.is-menu-open .mobile-menu-footer {
    opacity: 0.7;
  }
  .mobile-menu-footer a {
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .name,
    .page-label,
    .menu {
      display: none;
    }

    .menu-toggle,
    .mobile-menu {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu-link,
    .mobile-menu-footer {
      transition: none !important;
    }
  }
</style>