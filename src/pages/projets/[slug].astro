---
import Layout from "../../layouts/Layout.astro";
import DefaultReveal from "../../components/projects/DefaultReveal.astro";
import ElMagicoReveal from "../../components/projects/ElMagicoReveal.astro";
import { getProjectBySlug, getNextProject } from "../../lib/supabase";

export const prerender = false;

const { slug } = Astro.params;
const project = slug ? await getProjectBySlug(slug) : null;

if (!project) {
  return Astro.redirect("/");
}

const nextProject = await getNextProject(project);

// --- Introductions sur mesure ---
// Clé = le slug du projet dans Supabase. Un projet absent de cette
// liste utilise les scènes par défaut (DefaultReveal).
const customReveals = {
  "elmagicobarber": ElMagicoReveal,
};
const Reveal = customReveals[project.slug as keyof typeof customReveals] ?? DefaultReveal;

// --- Textes saisis dans Supabase ---
// Une ligne vide entre deux blocs = un nouveau paragraphe.
const paragraphs = (text?: string | null) =>
  (text ?? "")
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

// --- Thème du projet ---
// On n'accepte que des codes hexadécimaux (#0E0E16 ou #FFF) : ce qui
// est saisi dans Supabase part directement dans le CSS de la page.
const hexColor = (value?: string | null) => {
  const color = value?.trim();
  return color && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(color) ? color : null;
};

// Fond sombre ou clair ? (luminance relative, comme pour les contrastes
// d'accessibilité) — sert à choisir la couleur du header et, si aucune
// couleur de texte n'est renseignée, une couleur de texte lisible.
const isDarkColor = (hex: string) => {
  let digits = hex.slice(1);
  if (digits.length === 3) digits = [...digits].map((d) => d + d).join("");
  const [r, g, b] = [0, 2, 4].map((i) => {
    const channel = parseInt(digits.slice(i, i + 2), 16) / 255;
    return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.18;
};

const themeBg = hexColor(project.theme_bg);
const themeAccent = hexColor(project.theme_accent);
const bodyIsDark = themeBg ? isDarkColor(themeBg) : false;
const themeText =
  hexColor(project.theme_text) ?? (themeBg ? (bodyIsDark ? "#F5F1ED" : "#08080E") : null);

const themeStyle = [
  themeBg && `--project-bg: ${themeBg}`,
  themeText && `--project-text: ${themeText}`,
  themeAccent && `--project-accent: ${themeAccent}`,
]
  .filter(Boolean)
  .join("; ");

// --- Sections de l'étude de cas ---
// Tant que la section 01 n'est pas remplie, on retombe sur l'ancienne
// colonne "description" pour que les projets existants ne soient pas vides.
const overviewText = paragraphs(project.overview ?? project.description);

const facts = [
  { label: "Secteur", value: project.client_sector },
  { label: "Année", value: project.project_year },
  { label: "Prestations", value: project.services?.join(", ") },
  { label: "Outils", value: project.tools?.join(", ") },
].filter((fact) => fact.value && fact.value.trim() !== "");

const gallery = (project.gallery ?? []).filter((url) => url && url.trim() !== "");

const sections = [
  {
    id: "overview",
    label: "Project Overview",
    title: "Présentation générale",
    body: overviewText,
    visible: overviewText.length > 0 || facts.length > 0,
  },
  {
    id: "challenge",
    label: "The Challenge",
    title: "La problématique",
    body: paragraphs(project.challenge),
  },
  {
    id: "process",
    label: "The Creative Process",
    title: "La conception",
    body: paragraphs(project.process),
  },
  {
    id: "development",
    label: "Design & Development",
    title: "La réalisation",
    body: paragraphs(project.development),
    visible: paragraphs(project.development).length > 0 || gallery.length > 0,
  },
  {
    id: "outcome",
    label: "The Outcome",
    title: "Le résultat",
    body: paragraphs(project.outcome),
    visible: paragraphs(project.outcome).length > 0 || Boolean(project.site_url),
  },
]
  .filter((section) => section.visible ?? section.body.length > 0)
  // Numérotation continue des sections réellement affichées (01, 02…)
  .map((section, index) => ({ ...section, number: String(index + 1).padStart(2, "0") }));
---

<Layout title={`${project.title} — Zanith`} pageLabel="Projets" headerVariant="dark">
  <div class="project-page" style={themeStyle}>
    <!--
      PARTIE 1 — Introduction immersive : scènes sur mesure si le projet
      en a (voir customReveals), sinon scènes par défaut.
    -->
    <Reveal project={project} />

    <!-- PARTIE 2 — L'étude de cas -->
    <div class="project-body" data-header-theme={bodyIsDark ? "dark" : "light"}>
      <div class="project-body-inner">
        <a href="/" class="project-back">← Retour aux projets</a>

        {sections.map((section) => (
          <section class={`case-section case-section--${section.id}`} aria-labelledby={`case-${section.id}`}>
            <header class="case-section-head">
              <span class="case-section-label">
                {section.number} — {section.label}
              </span>
              <h2 class="case-section-title" id={`case-${section.id}`}>{section.title}</h2>
            </header>

            <div class="case-section-body">
              {section.body.map((paragraph) => <p>{paragraph}</p>)}

              {section.id === "overview" && facts.length > 0 && (
                <dl class="case-facts">
                  <div class="case-fact">
                    <dt>Client</dt>
                    <dd>{project.title}</dd>
                  </div>
                  {facts.map((fact) => (
                    <div class="case-fact">
                      <dt>{fact.label}</dt>
                      <dd>{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {section.id === "outcome" && project.site_url && (
                <a class="case-link" href={project.site_url} target="_blank" rel="noopener noreferrer">
                  Voir le site en ligne <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            {section.id === "development" && gallery.length > 0 && (
              <div class="case-gallery">
                {gallery.map((url) => (
                  <figure class="case-gallery-item">
                    <img src={url} alt="" loading="lazy" decoding="async" />
                  </figure>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    </div>

    <!-- Transition vers le projet suivant -->
    {nextProject && (
      <a href={`/projets/${nextProject.slug}`} class="next-project" data-header-theme="dark">
        <img class="next-project-media" src={nextProject.image_path} alt="" loading="lazy" decoding="async" />
        <div class="next-project-shade" aria-hidden="true"></div>
        <div class="next-project-content">
          <span class="next-project-kicker">Projet suivant</span>
          <span class="next-project-title">{nextProject.title}</span>
          <span class="next-project-category">{nextProject.category}</span>
          <span class="next-project-cta">
            Découvrir le projet <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    )}
  </div>
</Layout>

<script>
  import { initHeaderTheme } from "../../scripts/header-theme";
  initHeaderTheme();
</script>

<style>
  /* La couleur d'accent du projet (si renseignée) remplace celle du
     site sur toute la page : repères, numéros, liens… */
  .project-page {
    --accent: var(--project-accent, var(--color-orange-muted));
  }

  /* ============ Partie 2 — étude de cas ============ */

  .project-body {
    background: var(--project-bg, var(--bg-primary));
    color: var(--project-text, var(--text-primary));
  }

  .project-body-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--container-padding) clamp(4rem, 8vw, 7rem);
  }

  .project-back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: inherit;
    opacity: 0.6;
    text-decoration: none;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    transition: opacity 0.3s var(--ease-default);
  }
  .project-back:hover {
    opacity: 1;
  }

  /* Une section = libellé + titre à gauche, contenu à droite */
  .case-section {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  /* Le titre accompagne la lecture des longues sections */
  .case-section-head {
    align-self: start;
    position: sticky;
    top: 110px;
  }

  .case-section-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .case-section-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.1;
  }

  .case-section-body p {
    margin: 0 0 1.25em;
    max-width: 62ch;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.75;
    opacity: 0.88;
    /* Un simple retour à la ligne dans Supabase reste un retour à la
       ligne ; une ligne vide crée un nouveau paragraphe. */
    white-space: pre-line;
  }
  .case-section-body p:last-child {
    margin-bottom: 0;
  }

  /* --- 01 : fiche du projet --- */
  .case-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 2.5rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  .case-fact dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.55;
    margin-bottom: 0.4rem;
  }
  .case-fact dd {
    margin: 0;
    font-weight: 500;
    line-height: 1.5;
  }

  /* --- 04 : galerie en grand format, sur toute la largeur --- */
  .case-gallery {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .case-gallery-item {
    margin: 0;
  }
  /* La première image ouvre la galerie en pleine largeur */
  .case-gallery-item:first-child {
    grid-column: 1 / -1;
  }
  .case-gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  /* --- 05 : lien vers le site --- */
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
    padding: 0.9rem 1.6rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-default),
      border-color 0.3s var(--ease-default),
      color 0.3s var(--ease-default);
  }
  .case-link:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--color-cream);
  }

  @media (max-width: 800px) {
    .case-section {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-section-head {
      position: static;
    }
    .case-facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ============ Projet suivant ============ */

  .next-project {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-night);
    color: var(--color-cream);
    text-decoration: none;
  }

  .next-project-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-default);
  }
  .next-project:hover .next-project-media {
    transform: scale(1.04);
  }

  .next-project-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(8, 8, 14, 0.55), transparent 25%),
      linear-gradient(to top, rgba(8, 8, 14, 0.85), rgba(8, 8, 14, 0.2) 70%);
  }

  .next-project-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(3rem, 8vw, 6rem) var(--container-padding);
  }

  .next-project-kicker,
  .next-project-category,
  .next-project-cta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .next-project-kicker {
    color: var(--accent);
  }
  .next-project-category {
    opacity: 0.7;
  }

  .next-project-title {
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .next-project-cta {
    margin-top: 1rem;
    opacity: 0.85;
  }
  .next-project-cta span {
    display: inline-block;
    transition: transform 0.4s var(--ease-default);
  }
  .next-project:hover .next-project-cta span {
    transform: translateX(6px);
  }
</style>