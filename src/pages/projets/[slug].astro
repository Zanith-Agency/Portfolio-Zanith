---
import Layout from "../../layouts/Layout.astro";
import ProjectReveal from "../../components/ProjectReveal.astro";
import { getProjectBySlug, getNextProject } from "../../lib/supabase";

export const prerender = false;

const { slug } = Astro.params;
const project = slug ? await getProjectBySlug(slug) : null;

if (!project) {
  return Astro.redirect("/");
}

const nextProject = await getNextProject(project);

// --- Textes saisis dans Supabase ---
// Une ligne vide entre deux blocs = un nouveau paragraphe.
const paragraphs = (text?: string | null) =>
  (text ?? "")
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

// --- Thème du projet ---
// On n'accepte que des codes hexadécimaux (#0E0E16 ou #FFF) : ce qui
// est saisi dans Supabase part directement dans le CSS de la page.
const hexColor = (value?: string | null) => {
  const color = value?.trim();
  return color && /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(color) ? color : null;
};

// Fond sombre ou clair ? (luminance relative, comme pour les contrastes
// d'accessibilité) — sert à choisir la couleur du header et, si aucune
// couleur de texte n'est renseignée, une couleur de texte lisible.
const isDarkColor = (hex: string) => {
  let digits = hex.slice(1);
  if (digits.length === 3) digits = [...digits].map((d) => d + d).join("");
  const [r, g, b] = [0, 2, 4].map((i) => {
    const channel = parseInt(digits.slice(i, i + 2), 16) / 255;
    return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.18;
};

const themeBg = hexColor(project.theme_bg);
const themeAccent = hexColor(project.theme_accent);
const bodyIsDark = themeBg ? isDarkColor(themeBg) : false;
const themeText =
  hexColor(project.theme_text) ?? (themeBg ? (bodyIsDark ? "#F5F1ED" : "#08080E") : null);

const themeStyle = [
  themeBg && `--project-bg: ${themeBg}`,
  themeText && `--project-text: ${themeText}`,
  themeAccent && `--project-accent: ${themeAccent}`,
]
  .filter(Boolean)
  .join("; ");

// --- Sections de l'étude de cas ---
// Tant que la section 01 n'est pas remplie, on retombe sur l'ancienne
// colonne "description" pour que les projets existants ne soient pas vides.
const overviewText = paragraphs(project.overview ?? project.description);

const facts = [
  { label: "Secteur", value: project.client_sector },
  { label: "Année", value: project.project_year },
  { label: "Prestations", value: project.services?.join(", ") },
  { label: "Outils", value: project.tools?.join(", ") },
].filter((fact) => fact.value && fact.value.trim() !== "");

const gallery = (project.gallery ?? []).filter((url) => url && url.trim() !== "");

const sections = [
  {
    id: "overview",
    label: "Project Overview",
    title: "Présentation générale",
    body: overviewText,
    visible: overviewText.length > 0 || facts.length > 0,
  },
  {
    id: "challenge",
    label: "The Challenge",
    title: "La problématique",
    body: paragraphs(project.challenge),
  },
  {
    id: "process",
    label: "The Creative Process",
    title: "La conception",
    body: paragraphs(project.process),
  },
  {
    id: "development",
    label: "Design & Development",
    title: "La réalisation",
    body: paragraphs(project.development),
    visible: paragraphs(project.development).length > 0 || gallery.length > 0,
  },
  {
    id: "outcome",
    label: "The Outcome",
    title: "Le résultat",
    body: paragraphs(project.outcome),
    visible: paragraphs(project.outcome).length > 0 || Boolean(project.site_url),
  },
]
  .filter((section) => section.visible ?? section.body.length > 0)
  // Numérotation continue des sections réellement affichées (01, 02…)
  .map((section, index) => ({ ...section, number: String(index + 1).padStart(2, "0") }));
---

<Layout title={`${project.title} — Zanith`} pageLabel="Projets" headerVariant="dark">
  <div class="project-page" style={themeStyle}>
    <!--
      PARTIE 1 — Introduction immersive.
      Pour l'instant, tous les projets utilisent ces scènes par défaut,
      construites à partir des données Supabase. Le projet pilote (El
      Mágico) recevra ses propres scènes sur mesure à l'étape 4.
    -->
    <ProjectReveal>
      <!-- Univers 1 — PROJECT SHOWCASE : le résultat final -->
      <div slot="showcase" class="scene-showcase">
        <img
          class="scene-showcase-media"
          src={project.image_path}
          alt=""
          fetchpriority="high"
        />
        <div class="scene-showcase-shade" aria-hidden="true"></div>
        <div class="scene-showcase-content">
          <span class="scene-kicker">{project.category}</span>
          <h1 class="scene-showcase-title">{project.title}</h1>
          {project.tagline && <p class="scene-showcase-tagline">{project.tagline}</p>}
        </div>
      </div>

      <!--
        Univers 2 — BEHIND THE SCENES : les coulisses. Même image, mais
        sous une autre forme — cadrée comme une maquette sur une grille
        de travail, annotée, avec la stack technique — pour que le
        passage d'un univers à l'autre raconte quelque chose.
      -->
      <div slot="behind" class="scene-behind">
        <div class="scene-behind-grid" aria-hidden="true"></div>

        <div class="scene-behind-head">
          <span class="scene-kicker">Behind the scenes</span>
          <p class="scene-behind-title">{project.title}</p>
        </div>

        <figure class="scene-behind-frame">
          <span class="frame-mark frame-mark--tl" aria-hidden="true"></span>
          <span class="frame-mark frame-mark--tr" aria-hidden="true"></span>
          <span class="frame-mark frame-mark--bl" aria-hidden="true"></span>
          <span class="frame-mark frame-mark--br" aria-hidden="true"></span>
          <img src={project.image_path} alt="" loading="eager" decoding="async" />
          <figcaption class="frame-note frame-note--top">Maquette — v1</figcaption>
          <figcaption class="frame-note frame-note--side">1440 × 900</figcaption>
        </figure>

        {project.tools && project.tools.length > 0 && (
          <ol class="scene-behind-stack">
            {project.tools.map((tool, index) => (
              <li>
                <span class="stack-index">{String(index + 1).padStart(2, "0")}</span>
                <span>{tool}</span>
              </li>
            ))}
          </ol>
        )}
      </div>
    </ProjectReveal>

    <!-- PARTIE 2 — L'étude de cas -->
    <div class="project-body" data-header-theme={bodyIsDark ? "dark" : "light"}>
      <div class="project-body-inner">
        <a href="/" class="project-back">← Retour aux projets</a>

        {sections.map((section) => (
          <section class={`case-section case-section--${section.id}`} aria-labelledby={`case-${section.id}`}>
            <header class="case-section-head">
              <span class="case-section-label">
                {section.number} — {section.label}
              </span>
              <h2 class="case-section-title" id={`case-${section.id}`}>{section.title}</h2>
            </header>

            <div class="case-section-body">
              {section.body.map((paragraph) => <p>{paragraph}</p>)}

              {section.id === "overview" && facts.length > 0 && (
                <dl class="case-facts">
                  <div class="case-fact">
                    <dt>Client</dt>
                    <dd>{project.title}</dd>
                  </div>
                  {facts.map((fact) => (
                    <div class="case-fact">
                      <dt>{fact.label}</dt>
                      <dd>{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {section.id === "outcome" && project.site_url && (
                <a class="case-link" href={project.site_url} target="_blank" rel="noopener noreferrer">
                  Voir le site en ligne <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            {section.id === "development" && gallery.length > 0 && (
              <div class="case-gallery">
                {gallery.map((url) => (
                  <figure class="case-gallery-item">
                    <img src={url} alt="" loading="lazy" decoding="async" />
                  </figure>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    </div>

    <!-- Transition vers le projet suivant -->
    {nextProject && (
      <a href={`/projets/${nextProject.slug}`} class="next-project" data-header-theme="dark">
        <img class="next-project-media" src={nextProject.image_path} alt="" loading="lazy" decoding="async" />
        <div class="next-project-shade" aria-hidden="true"></div>
        <div class="next-project-content">
          <span class="next-project-kicker">Projet suivant</span>
          <span class="next-project-title">{nextProject.title}</span>
          <span class="next-project-category">{nextProject.category}</span>
          <span class="next-project-cta">
            Découvrir le projet <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    )}
  </div>
</Layout>

<script>
  import { initHeaderTheme } from "../../scripts/header-theme";
  initHeaderTheme();
</script>

<style>
  /* La couleur d'accent du projet (si renseignée) remplace celle du
     site sur toute la page : repères, numéros, liens… */
  .project-page {
    --accent: var(--project-accent, var(--color-orange-muted));
  }

  /* ============ Partie 1 — scènes par défaut ============ */

  .scene-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cream);
    opacity: 0.75;
  }

  /* --- Univers 1 : vitrine --- */
  .scene-showcase {
    position: absolute;
    inset: 0;
    background: var(--color-night);
  }

  .scene-showcase-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Assombrit le haut (lisibilité du header) et le bas (titre) */
  .scene-showcase-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(8, 8, 14, 0.55), transparent 22%),
      linear-gradient(to top, rgba(8, 8, 14, 0.75), transparent 55%);
  }

  .scene-showcase-content {
    position: absolute;
    left: var(--container-padding);
    right: var(--container-padding);
    bottom: clamp(6.5rem, 16vh, 9rem);
  }

  .scene-showcase-title {
    margin: 0.75rem 0 0;
    font-weight: 800;
    font-size: clamp(2.75rem, 9vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .scene-showcase-tagline {
    margin: 1.1rem 0 0;
    max-width: 38ch;
    font-weight: 300;
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-cream);
    opacity: 0.85;
  }

  /* --- Univers 2 : coulisses --- */
  .scene-behind {
    position: absolute;
    inset: 0;
    background: var(--color-carbon);
    color: var(--color-cream);
  }

  .scene-behind-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-cream) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-cream) 7%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center;
  }

  .scene-behind-head {
    position: absolute;
    top: calc(80px + 2.5rem);
    left: var(--container-padding);
  }

  .scene-behind-title {
    margin: 0.6rem 0 0;
    font-weight: 800;
    font-size: clamp(1.75rem, 4.5vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-cream) 70%, transparent);
  }

  .scene-behind-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(56vw, 760px);
    aspect-ratio: 16 / 10;
    margin: 0;
    transform: translate(-50%, -46%);
  }

  .scene-behind-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 1px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
    filter: grayscale(1) contrast(1.1) brightness(0.85);
  }

  /* Repères de coupe aux quatre coins */
  .frame-mark {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }
  .frame-mark--tl { top: -10px; left: -10px; border-top-width: 1px; border-left-width: 1px; }
  .frame-mark--tr { top: -10px; right: -10px; border-top-width: 1px; border-right-width: 1px; }
  .frame-mark--bl { bottom: -10px; left: -10px; border-bottom-width: 1px; border-left-width: 1px; }
  .frame-mark--br { bottom: -10px; right: -10px; border-bottom-width: 1px; border-right-width: 1px; }

  .frame-note {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .frame-note--top {
    bottom: calc(100% + 0.9rem);
    left: 0;
  }
  .frame-note--side {
    top: 0;
    left: calc(100% + 1.1rem);
    writing-mode: vertical-rl;
  }

  .scene-behind-stack {
    position: absolute;
    right: var(--container-padding);
    bottom: clamp(6.5rem, 16vh, 9rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .scene-behind-stack li {
    display: flex;
    gap: 0.9rem;
  }
  .stack-index {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .scene-behind-frame {
      width: 84vw;
      transform: translate(-50%, -58%);
    }
    .frame-note--side {
      display: none;
    }
    .scene-behind-stack {
      left: var(--container-padding);
      right: auto;
    }
  }

  /* ============ Partie 2 — étude de cas ============ */

  .project-body {
    background: var(--project-bg, var(--bg-primary));
    color: var(--project-text, var(--text-primary));
  }

  .project-body-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--container-padding) clamp(4rem, 8vw, 7rem);
  }

  .project-back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: inherit;
    opacity: 0.6;
    text-decoration: none;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    transition: opacity 0.3s var(--ease-default);
  }
  .project-back:hover {
    opacity: 1;
  }

  /* Une section = libellé + titre à gauche, contenu à droite */
  .case-section {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  /* Le titre accompagne la lecture des longues sections */
  .case-section-head {
    align-self: start;
    position: sticky;
    top: 110px;
  }

  .case-section-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .case-section-title {
    margin: 0;
    font-weight: 300;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.1;
  }

  .case-section-body p {
    margin: 0 0 1.25em;
    max-width: 62ch;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.75;
    opacity: 0.88;
    /* Un simple retour à la ligne dans Supabase reste un retour à la
       ligne ; une ligne vide crée un nouveau paragraphe. */
    white-space: pre-line;
  }
  .case-section-body p:last-child {
    margin-bottom: 0;
  }

  /* --- 01 : fiche du projet --- */
  .case-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 2.5rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  .case-fact dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.55;
    margin-bottom: 0.4rem;
  }
  .case-fact dd {
    margin: 0;
    font-weight: 500;
    line-height: 1.5;
  }

  /* --- 04 : galerie en grand format, sur toute la largeur --- */
  .case-gallery {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .case-gallery-item {
    margin: 0;
  }
  /* La première image ouvre la galerie en pleine largeur */
  .case-gallery-item:first-child {
    grid-column: 1 / -1;
  }
  .case-gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  /* --- 05 : lien vers le site --- */
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
    padding: 0.9rem 1.6rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-default),
      border-color 0.3s var(--ease-default),
      color 0.3s var(--ease-default);
  }
  .case-link:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--color-cream);
  }

  @media (max-width: 800px) {
    .case-section {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-section-head {
      position: static;
    }
    .case-facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ============ Projet suivant ============ */

  .next-project {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-night);
    color: var(--color-cream);
    text-decoration: none;
  }

  .next-project-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-default);
  }
  .next-project:hover .next-project-media {
    transform: scale(1.04);
  }

  .next-project-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(8, 8, 14, 0.55), transparent 25%),
      linear-gradient(to top, rgba(8, 8, 14, 0.85), rgba(8, 8, 14, 0.2) 70%);
  }

  .next-project-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(3rem, 8vw, 6rem) var(--container-padding);
  }

  .next-project-kicker,
  .next-project-category,
  .next-project-cta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .next-project-kicker {
    color: var(--accent);
  }
  .next-project-category {
    opacity: 0.7;
  }

  .next-project-title {
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .next-project-cta {
    margin-top: 1rem;
    opacity: 0.85;
  }
  .next-project-cta span {
    display: inline-block;
    transition: transform 0.4s var(--ease-default);
  }
  .next-project:hover .next-project-cta span {
    transform: translateX(6px);
  }
</style>