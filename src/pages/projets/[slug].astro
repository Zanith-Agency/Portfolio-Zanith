---
import Layout from "../../layouts/Layout.astro";
import ProjectReveal from "../../components/ProjectReveal.astro";
import { getProjectBySlug } from "../../lib/supabase";

export const prerender = false;

const { slug } = Astro.params;
const project = slug ? await getProjectBySlug(slug) : null;

if (!project) {
  return Astro.redirect("/");
}
---

<Layout title={`${project.title} — Zanith`} pageLabel="Projets" headerVariant="dark">
  <!--
    PARTIE 1 — Introduction immersive.
    Pour l'instant, tous les projets utilisent ces scènes par défaut,
    construites à partir des données Supabase. Le projet pilote (El
    Mágico) recevra ses propres scènes sur mesure à l'étape 4.
  -->
  <ProjectReveal>
    <!-- Univers 1 — PROJECT SHOWCASE : le résultat final -->
    <div slot="showcase" class="scene-showcase">
      <img
        class="scene-showcase-media"
        src={project.image_path}
        alt=""
        fetchpriority="high"
      />
      <div class="scene-showcase-shade" aria-hidden="true"></div>
      <div class="scene-showcase-content">
        <span class="scene-kicker">{project.category}</span>
        <h1 class="scene-showcase-title">{project.title}</h1>
      </div>
    </div>

    <!--
      Univers 2 — BEHIND THE SCENES : les coulisses. Même image, mais
      sous une autre forme — cadrée comme une maquette sur une grille
      de travail, annotée, avec la stack technique — pour que le
      passage d'un univers à l'autre raconte quelque chose.
    -->
    <div slot="behind" class="scene-behind">
      <div class="scene-behind-grid" aria-hidden="true"></div>

      <div class="scene-behind-head">
        <span class="scene-kicker">Behind the scenes</span>
        <p class="scene-behind-title">{project.title}</p>
      </div>

      <figure class="scene-behind-frame">
        <span class="frame-mark frame-mark--tl" aria-hidden="true"></span>
        <span class="frame-mark frame-mark--tr" aria-hidden="true"></span>
        <span class="frame-mark frame-mark--bl" aria-hidden="true"></span>
        <span class="frame-mark frame-mark--br" aria-hidden="true"></span>
        <img src={project.image_path} alt="" loading="eager" decoding="async" />
        <figcaption class="frame-note frame-note--top">Maquette — v1</figcaption>
        <figcaption class="frame-note frame-note--side">1440 × 900</figcaption>
      </figure>

      {project.tools?.length > 0 && (
        <ol class="scene-behind-stack">
          {project.tools.map((tool, index) => (
            <li>
              <span class="stack-index">{String(index + 1).padStart(2, "0")}</span>
              <span>{tool}</span>
            </li>
          ))}
        </ol>
      )}
    </div>
  </ProjectReveal>

  <!--
    PARTIE 2 — Contenu détaillé. Provisoire : on garde ici les infos
    existantes en attendant les 5 sections (étape 2).
  -->
  <section class="project-detail">
    <a href="/" class="project-back">← Retour</a>

    <div class="project-info">
      <span class="project-category">{project.category}</span>
      <h2 class="project-title">{project.title}</h2>
      {project.description && <p class="project-description">{project.description}</p>}

      {project.tools?.length > 0 && (
        <ul class="project-tools">
          {project.tools.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </div>
  </section>
</Layout>

<style>
  /* ============ Scènes par défaut ============ */

  .scene-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cream);
    opacity: 0.75;
  }

  /* --- Univers 1 : vitrine --- */
  .scene-showcase {
    position: absolute;
    inset: 0;
    background: var(--color-night);
  }

  .scene-showcase-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Assombrit le haut (lisibilité du header) et le bas (titre) */
  .scene-showcase-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(8, 8, 14, 0.55), transparent 22%),
      linear-gradient(to top, rgba(8, 8, 14, 0.75), transparent 55%);
  }

  .scene-showcase-content {
    position: absolute;
    left: var(--container-padding);
    right: var(--container-padding);
    bottom: clamp(6.5rem, 16vh, 9rem);
  }

  .scene-showcase-title {
    margin: 0.75rem 0 0;
    font-weight: 800;
    font-size: clamp(2.75rem, 9vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  /* --- Univers 2 : coulisses --- */
  .scene-behind {
    position: absolute;
    inset: 0;
    background: var(--color-carbon);
    color: var(--color-cream);
  }

  .scene-behind-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-cream) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-cream) 7%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center;
  }

  .scene-behind-head {
    position: absolute;
    top: calc(80px + 2.5rem);
    left: var(--container-padding);
  }

  .scene-behind-title {
    margin: 0.6rem 0 0;
    font-weight: 800;
    font-size: clamp(1.75rem, 4.5vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-cream) 70%, transparent);
  }

  .scene-behind-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(56vw, 760px);
    aspect-ratio: 16 / 10;
    margin: 0;
    transform: translate(-50%, -46%);
  }

  .scene-behind-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 1px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
    filter: grayscale(1) contrast(1.1) brightness(0.85);
  }

  /* Repères de coupe aux quatre coins */
  .frame-mark {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }
  .frame-mark--tl { top: -10px; left: -10px; border-top-width: 1px; border-left-width: 1px; }
  .frame-mark--tr { top: -10px; right: -10px; border-top-width: 1px; border-right-width: 1px; }
  .frame-mark--bl { bottom: -10px; left: -10px; border-bottom-width: 1px; border-left-width: 1px; }
  .frame-mark--br { bottom: -10px; right: -10px; border-bottom-width: 1px; border-right-width: 1px; }

  .frame-note {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .frame-note--top {
    bottom: calc(100% + 0.9rem);
    left: 0;
  }
  .frame-note--side {
    top: 0;
    left: calc(100% + 1.1rem);
    writing-mode: vertical-rl;
  }

  .scene-behind-stack {
    position: absolute;
    right: var(--container-padding);
    bottom: clamp(6.5rem, 16vh, 9rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .scene-behind-stack li {
    display: flex;
    gap: 0.9rem;
  }
  .stack-index {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .scene-behind-frame {
      width: 84vw;
      transform: translate(-50%, -58%);
    }
    .frame-note--side {
      display: none;
    }
    .scene-behind-stack {
      left: var(--container-padding);
      right: auto;
    }
  }

  /* ============ Partie 2 (provisoire) ============ */

  .project-detail {
    max-width: 1000px;
    margin: 0 auto;
    padding: 100px var(--container-padding) 100px;
  }
  .project-back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    opacity: 0.6;
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: opacity 0.3s var(--ease-default);
  }
  .project-back:hover { opacity: 1; }

  .project-category {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.6;
    margin-bottom: 0.75rem;
  }
  .project-title {
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0 0 1.5rem;
  }
  .project-description {
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 640px;
    opacity: 0.85;
    margin: 0 0 2rem;
  }
  .project-tools {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    font-family: var(--font-mono); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .project-tools li {
    border: 1px solid color-mix(in srgb, var(--text-primary) 25%, transparent);
    padding: 0.35rem 0.75rem; border-radius: 999px;
  }
</style>