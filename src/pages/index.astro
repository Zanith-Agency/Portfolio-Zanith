---
import Layout from "../layouts/Layout.astro";
import { getProjects } from "../lib/supabase";

export const prerender = false;

const projects = await getProjects();
---

<Layout title="Zanith — Nadir Gherich" isHome headerVariant="dark" pageLabel="Travail">
  <section class="hero" data-reveal-after-intro>
    <div class="project-orbit" id="project-orbit">
      <div class="project-orbit-center">
        <span class="project-orbit-mark">Zanith</span>
      </div>

      {projects.map((project) => (
        <a href={`/projets/${project.slug}`} class="project-orbit-item">
          <span class="project-orbit-hint">
           Clic pour découvrir le projet <span class="project-orbit-hint-arrow">→</span>
          </span>
          <span class="project-orbit-item-inner">
            <img src={project.image_path} alt={project.title} loading="eager" />
          </span>
          <span class="project-orbit-caption">
            <span class="project-orbit-title">{project.title}</span>
            <span class="project-orbit-category">{project.category}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <script>
    import { initIntro } from "../scripts/intro";
    import { initProjectOrbit } from "../scripts/project-orbit";
    initIntro();
    initProjectOrbit();
  </script>
</Layout>

<style>
  .hero {
    position: relative; min-height: 100vh;
    /* Rien ne doit dépasser sur les côtés (projets près du bord) : sur
       téléphone, un débordement même invisible élargit la page. */
    overflow-x: clip;
    background: var(--bg-inverse);
    padding-top: 80px;
    display: flex; align-items: center; justify-content: center;
  }

  .project-orbit {
    position: relative;
    width: min(65vw, 620px);
    height: min(65vw, 620px);
  }

  .project-orbit-center {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
  }
  .project-orbit-mark {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-inverse);
    opacity: 0.5;
  }

  .project-orbit-item {
    position: absolute;
    top: 50%; left: 50%;
    width: 170px;
    display: block;
    text-decoration: none;
    z-index: 2;
    /* Le cercle démarre vide : chaque projet est invisible et non
       cliquable tant qu'il n'est pas entré dans la roulette (classe
       .is-revealed posée par project-orbit.js). Le transform de
       positionnement et l'opacité sont ensuite gérés en JS à chaque
       frame. */
    opacity: 0;
    pointer-events: none;
  }
  .project-orbit-item.is-revealed {
    pointer-events: auto;
  }

  /* Pendant la fermeture : plus aucun clic possible, et on masque les
     légendes/indices qui resteraient affichés sous la souris. */
  .project-orbit.is-closing .project-orbit-item {
    pointer-events: none;
  }
  .project-orbit.is-closing .project-orbit-caption,
  .project-orbit.is-closing .project-orbit-hint {
    opacity: 0 !important;
  }

  .project-orbit-item-inner {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    overflow: hidden;
    transform: scale(1);
    transition: transform 0.4s var(--ease-default);
  }
  .project-orbit-item:hover .project-orbit-item-inner {
    transform: scale(1.06);
  }
  .project-orbit-item-inner img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .project-orbit-caption {
    position: absolute;
    top: 100%; left: 50%;
    transform: translateX(-50%);
    margin-top: 0.6rem;
    display: flex; flex-direction: column; align-items: center; gap: 0.2rem;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s var(--ease-default);
    white-space: nowrap;
  }
  .project-orbit-item:hover .project-orbit-caption {
    opacity: 1;
  }
  .project-orbit-title {
    font-weight: 700; font-size: 0.85rem; color: var(--text-inverse);
  }
  .project-orbit-category {
    font-family: var(--font-mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-inverse); opacity: 0.7;
  }

  /* --- Téléphone (portrait) ---
     L'écran est bien plus haut que large : un cercle limité par la
     largeur (~310 px) serre les projets au point qu'ils se chevauchent.
     On donne à l'orbite toute la largeur utile ET la hauteur de l'écran
     sous le header : project-orbit.js en fait un ovale vertical. */
  @media (max-width: 700px) {
    .hero {
      min-height: 100vh;
      min-height: 100svh;
    }
    .project-orbit {
      width: calc(100vw - 2 * var(--container-padding));
      height: min(calc(100svh - 80px - 7rem), 640px);
    }
    .project-orbit-item {
      width: clamp(84px, 26vw, 112px);
    }
    /* Légende réduite au titre : la catégorie chargerait l'écran */
    .project-orbit-caption {
      margin-top: 0.45rem;
    }
    .project-orbit-title {
      font-size: 0.78rem;
    }
    .project-orbit-category {
      display: none;
    }
  }

  /* --- Téléphone en paysage / écrans très bas ---
     Même principe dans l'autre sens : ovale horizontal. */
  @media (max-height: 560px) and (orientation: landscape) {
    .hero {
      min-height: 100svh;
    }
    .hero {
      padding-top: 64px;
    }
    .project-orbit {
      width: min(84vw, 760px);
      height: calc(100svh - 64px - 1.5rem);
    }
    .project-orbit-item {
      width: 76px;
    }
    .project-orbit-title {
      font-size: 0.72rem;
    }
    .project-orbit-caption {
      margin-top: 0.3rem;
    }
    .project-orbit-category {
      display: none;
    }
  }

  .project-orbit-hint {
  position: absolute;
  bottom: 100%; left: 50%;
  transform: translateX(-50%);
  margin-bottom: 0.6rem;
  display: flex; align-items: center; gap: 0.35rem;
  white-space: nowrap;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-inverse);
  opacity: 0;
  transition: opacity 0.3s var(--ease-default);
  pointer-events: none;
}
.project-orbit-item:hover .project-orbit-hint {
  opacity: 0.85;
}
.project-orbit-hint-arrow {
  display: inline-block;
}

  /* --- Tactile : .project-orbit-caption et .project-orbit-hint ne
     s'affichent qu'au :hover, qui n'existe pas au doigt — sans ça, un
     visiteur mobile voit juste des photos qui flottent, sans titre, ni
     indication que ce sont des liens cliquables. On rend la légende
     (titre + catégorie) permanente sur ces appareils ; on laisse le
     hint "Clic pour découvrir..." hover-only, son texte est trop long
     pour rester lisible en permanence sur des vignettes de 110px sans
     se chevaucher entre projets voisins sur l'orbite. --- */
  @media (hover: none) {
    .project-orbit-caption {
      opacity: 1;
    }
    /* L'indication "Clic pour découvrir…" n'apparaît qu'au survol de la
       souris : inutile au doigt, et elle dépassait de l'écran près des
       bords (la page se retrouvait plus large que le téléphone). */
    .project-orbit-hint {
      display: none;
    }
  }
</style>