---
import Layout from "../layouts/Layout.astro";
import { getProjects } from "../lib/supabase";

export const prerender = false;

const projects = await getProjects();
---

<Layout title="Zanith — Nadir Gherich" isHome headerVariant="dark" pageLabel="Travail">
  <section class="hero" data-reveal-after-intro>
    <div class="project-orbit" id="project-orbit">
      <div class="project-orbit-center">
        <span class="project-orbit-mark">Zanith</span>
      </div>

      {projects.map((project) => (
        <a href={`/projets/${project.slug}`} class="project-orbit-item">
          <span class="project-orbit-hint">
           Clic pour découvrir le projet <span class="project-orbit-hint-arrow">→</span>
          </span>
          <span class="project-orbit-item-inner">
            <img src={project.image_path} alt={project.title} loading="eager" />
          </span>
          <span class="project-orbit-caption">
            <span class="project-orbit-title">{project.title}</span>
            <span class="project-orbit-category">{project.category}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <script>
    import { initIntro } from "../scripts/intro";
    import { initProjectOrbit } from "../scripts/project-orbit";
    initIntro();
    initProjectOrbit();
  </script>
</Layout>

<style>
  .hero {
    position: relative; min-height: 100vh;
    background: var(--bg-inverse);
    padding-top: 80px;
    display: flex; align-items: center; justify-content: center;
  }

  .project-orbit {
    position: relative;
    width: min(65vw, 620px);
    height: min(65vw, 620px);
  }

  .project-orbit-center {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    pointer-events: none;
  }
  .project-orbit-mark {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-inverse);
    opacity: 0.5;
  }

  .project-orbit-item {
    position: absolute;
    top: 50%; left: 50%;
    width: 170px;
    display: block;
    text-decoration: none;
    /* le transform de positionnement (translate + coordonnées orbite) est posé en JS à chaque frame */
  }

  .project-orbit-item-inner {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    overflow: hidden;
    transform: scale(1);
    transition: transform 0.4s var(--ease-default);
  }
  .project-orbit-item:hover .project-orbit-item-inner {
    transform: scale(1.06);
  }
  .project-orbit-item-inner img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .project-orbit-caption {
    position: absolute;
    top: 100%; left: 50%;
    transform: translateX(-50%);
    margin-top: 0.6rem;
    display: flex; flex-direction: column; align-items: center; gap: 0.2rem;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s var(--ease-default);
    white-space: nowrap;
  }
  .project-orbit-item:hover .project-orbit-caption {
    opacity: 1;
  }
  .project-orbit-title {
    font-weight: 700; font-size: 0.85rem; color: var(--text-inverse);
  }
  .project-orbit-category {
    font-family: var(--font-mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-inverse); opacity: 0.7;
  }

  @media (max-width: 700px) {
    .project-orbit { width: min(80vw, 420px); height: min(80vw, 420px); }
    .project-orbit-item { width: 110px; }
  }

  .project-orbit-hint {
  position: absolute;
  bottom: 100%; left: 50%;
  transform: translateX(-50%);
  margin-bottom: 0.6rem;
  display: flex; align-items: center; gap: 0.35rem;
  white-space: nowrap;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-inverse);
  opacity: 0;
  transition: opacity 0.3s var(--ease-default);
  pointer-events: none;
}
.project-orbit-item:hover .project-orbit-hint {
  opacity: 0.85;
}
.project-orbit-hint-arrow {
  display: inline-block;
}

  /* --- Tactile : .project-orbit-caption et .project-orbit-hint ne
     s'affichent qu'au :hover, qui n'existe pas au doigt — sans ça, un
     visiteur mobile voit juste des photos qui flottent, sans titre, ni
     indication que ce sont des liens cliquables. On rend la légende
     (titre + catégorie) permanente sur ces appareils ; on laisse le
     hint "Clic pour découvrir..." hover-only, son texte est trop long
     pour rester lisible en permanence sur des vignettes de 110px sans
     se chevaucher entre projets voisins sur l'orbite. --- */
  @media (hover: none) {
    .project-orbit-caption {
      opacity: 1;
    }
  }
</style>